--[[
  JHC Hit Checker for Juju (Hood Customs)   v1.0.0
  Single-file bundle generated by tools/build.py - edit src/*.lua, not this file.

  WHAT IT DOES
    * Hit Checker: counts shot attempts, CONFIRMED hits (server-replicated damage on another
      player), misses (no damage on a healthy connection), unconfirmed and not-fired shots.
    * Connection diagnostics from the documented API only: juju.get_ping(), server/client
      CFrame gap; derives jitter, spikes, stalls and an adaptive confirmation window.
    * Double Barrel Shotgun identification + Auto Mode tracking profile (it does NOT fire).
    * Read-only towards Juju: never calls set_*/add_*/remove_*/purchase_item/load_config and only
      writes flags named jhc_*.

  WHAT IT CANNOT DO (not exposed by the Juju docs): see docs/API_REFERENCE.md. In particular
  the connection exploit itself is not observable; only its visible effects (ping, gap, timing)
  are measured.

  CONFIGURATION (all optional; invalid values are reported and ignored)
    1. edit USER_CONFIG below, or
    2. before running this script:  getgenv().JHC_CONFIG = { scope = "target", ... }
    3. set flags jhc_cfg_<key> through another addon.
  See src/config.lua for every key.
]]

local USER_CONFIG = {
  -- weapon_aliases = { "doublebarrel", "dbsg" },   -- letters only, matched against the tool name
  -- scope = "auto",                                  -- "auto" | "target" | "all"
  -- hud = true,
}
do
  local ok, g = pcall(function() return getgenv and getgenv() end)
  if ok and type(g) == "table" and type(g.JHC_CONFIG) == "table" then
    for k, v in pairs(g.JHC_CONFIG) do USER_CONFIG[k] = v end
  end
end

local __defs, __cache = {}, {}
local function __require(name)
  local cached = __cache[name]
  if cached ~= nil then return cached end
  local def = __defs[name]
  if not def then error("jhc bundle: unknown module " .. tostring(name)) end
  local mod = def(__require)
  __cache[name] = mod
  return mod
end

__defs["util"] = function(require)
-- util.lua
-- Small dependency-free helpers. Written in the common subset of Lua 5.1 / LuaJIT / Luau
-- (no `continue`, no compound assignment, no type annotations) so the same file runs in the
-- test interpreter and inside Juju.

local U = {}

U.unpack = table.unpack or unpack

function U.clamp(v, lo, hi)
  if v < lo then return lo end
  if v > hi then return hi end
  return v
end

function U.is_finite(n)
  return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function U.clear(t)
  for k in pairs(t) do t[k] = nil end
end

function U.shallow_copy(t)
  local r = {}
  for k, v in pairs(t) do r[k] = v end
  return r
end

function U.count(t)
  local n = 0
  for _ in pairs(t) do n = n + 1 end
  return n
end

-- Lower-case, letters only. "[Double-Barrel SG] - 2 | 2" -> "doublebarrelsg".
-- Digits are dropped on purpose: some games append ammo counts to the tool name.
function U.normalize_name(s)
  if type(s) ~= "string" then return "" end
  return (string.lower(s):gsub("[^a-z]", ""))
end

-- ---------------------------------------------------------------------------------------
-- Fixed-size ring buffer. get(1) is the oldest element, get(size()) the newest.
-- ---------------------------------------------------------------------------------------
local Ring = {}
Ring.__index = Ring

function Ring.new(cap)
  if type(cap) ~= "number" or cap < 1 then cap = 1 end
  return setmetatable({ cap = math.floor(cap), buf = {}, head = 0, n = 0 }, Ring)
end

function Ring:push(v)
  self.head = self.head % self.cap + 1
  self.buf[self.head] = v
  if self.n < self.cap then self.n = self.n + 1 end
end

function Ring:size() return self.n end

function Ring:get(i)
  if i < 1 or i > self.n then return nil end
  return self.buf[(self.head - self.n + i - 1) % self.cap + 1]
end

function Ring:last() return self:get(self.n) end

function Ring:to_array()
  local r = {}
  for i = 1, self.n do r[i] = self:get(i) end
  return r
end

function Ring:clear()
  self.buf = {}
  self.head = 0
  self.n = 0
end

U.Ring = Ring

-- ---------------------------------------------------------------------------------------
-- Small statistics helpers (nearest-rank percentiles; arrays are not modified).
-- ---------------------------------------------------------------------------------------
function U.percentile(arr, p)
  local n = #arr
  if n == 0 then return nil end
  local c = {}
  for i = 1, n do c[i] = arr[i] end
  table.sort(c)
  local rank = math.ceil(p / 100 * n)
  if rank < 1 then rank = 1 end
  if rank > n then rank = n end
  return c[rank]
end

function U.median(arr) return U.percentile(arr, 50) end

function U.mean(arr)
  local n = #arr
  if n == 0 then return nil end
  local s = 0
  for i = 1, n do s = s + arr[i] end
  return s / n
end

-- ---------------------------------------------------------------------------------------
-- Bag: keyed connection manager.
--   * set() on an existing key disconnects the old connection first -> no duplicate listeners
--   * every callback is wrapped in pcall; errors go to on_error instead of killing the handler
--   * clear()/drop_prefix() disconnect deterministically
-- `connector(signal, fn)` is supplied by the host (juju.create_connection or :Connect).
-- ---------------------------------------------------------------------------------------
local Bag = {}
Bag.__index = Bag

function Bag.new(connector, on_error)
  return setmetatable({ connector = connector, on_error = on_error, conns = {}, n = 0 }, Bag)
end

local function disconnect(conn)
  if conn ~= nil then
    pcall(function() conn:Disconnect() end)
  end
end

function Bag:set(key, signal, fn)
  self:drop(key)
  if signal == nil then return nil end
  local on_error = self.on_error
  local function guarded(...)
    local ok, err = pcall(fn, ...)
    if not ok and on_error then on_error(key, err) end
  end
  local ok, conn = pcall(self.connector, signal, guarded)
  if not ok or conn == nil then
    if on_error then on_error(key, "connect failed: " .. tostring(conn)) end
    return nil
  end
  self.conns[key] = conn
  self.n = self.n + 1
  return conn
end

function Bag:drop(key)
  local c = self.conns[key]
  if c ~= nil then
    self.conns[key] = nil
    self.n = self.n - 1
    disconnect(c)
  end
end

function Bag:drop_prefix(prefix)
  local keys = {}
  local len = #prefix
  for k in pairs(self.conns) do
    if string.sub(k, 1, len) == prefix then keys[#keys + 1] = k end
  end
  for i = 1, #keys do self:drop(keys[i]) end
end

function Bag:clear()
  local keys = {}
  for k in pairs(self.conns) do keys[#keys + 1] = k end
  for i = 1, #keys do self:drop(keys[i]) end
end

function Bag:has(key) return self.conns[key] ~= nil end
function Bag:size() return self.n end

U.Bag = Bag

-- ---------------------------------------------------------------------------------------
-- Logger: bounded history, optional console output when cfg.debug is true.
-- ---------------------------------------------------------------------------------------
function U.make_logger(cfg, sink, cap)
  local ring = Ring.new(cap or 200)
  local L = { ring = ring }
  function L.log(level, msg)
    ring:push({ level = level, msg = msg })
    if level == "error" or level == "warn" or cfg.debug then
      if sink then pcall(sink, "[" .. level .. "] " .. tostring(msg)) end
    end
  end
  return L
end

return U

end

__defs["config"] = function(require)
-- config.lua
-- Defaults, schema validation and runtime updates.
-- Precedence (lowest -> highest): defaults < USER_CONFIG table in the bundle header
--                                  < flags named jhc_cfg_<key> < menu elements.
-- Invalid values never throw: they are replaced by the default (or clamped) and reported in
-- `problems`.

local U = require("util")

local C = {}
C.VERSION = "1.0.0"

C.defaults = {
  -- feature switches
  enabled = true,            -- master switch for shot/hit tracking
  hud = true,                -- on-screen overlay (needs Drawing)
  debug = false,             -- echo log lines to the console
  tab_summary = false,       -- show a 12-char live summary on the Juju tab
  auto_mode = false,         -- Auto Mode tracking profile
  follow_host_auto = false,  -- treat Juju's own auto flag as Auto Mode ON
  host_auto_flag = "",       -- exact name of Juju's auto flag, "" = discover by name

  -- LIVE FINDING: the running Juju exposes signals the docs do not list (discovered through the
  -- documented juju.get_signals()/get_signal()). on_local_bullet_confirmed(player, part, "-15") is
  -- Juju's own confirmation that a LOCAL bullet hit someone. When present it is used as the strongest
  -- hit evidence (it removes the "somebody else's damage" ambiguity).
  use_juju_signals = true,
  -- LIVE FINDING: guns in Hood Customs do NOT fire Tool.Activated (melee does). Juju's
  -- on_player_bullet_fired does fire, once per bullet/pellet, and a two-client test showed each
  -- client only receives its OWN bullets. It is therefore used as the shot-attempt source for guns.
  use_bullet_signal = true,
  pellet_gap = 0.05,         -- bullets this close together (s) are one trigger pull
  confirm_match = 0.5,       -- a Juju confirmation corroborates a health-inferred hit up to this long after it (s)
  -- LIVE FINDING: confirmations arrive 200-330ms after the shot while the window sits at its 200ms
  -- floor, so every shot expired before its own confirmation and nothing could ever be confirmed -
  -- which also starved the window of the trusted latencies it needs to grow. A confirmation that
  -- arrives this long after an already-resolved shot promotes it to a hit and teaches the window.
  confirm_horizon = 1.5,

  -- which players' damage can confirm a hit: "auto" (ragebot target if set, else all),
  -- "target" (ragebot target only), "all" (every other player)
  scope = "auto",

  -- hit attribution
  causal_check = true,       -- ignore damage that arrives sooner than physically possible
  causal_ratio = 0.5,        -- ... i.e. earlier than causal_ratio * ping at shot time
  burst_gap = 0.03,          -- damage events closer than this (s) are one shot's pellets
  dedupe_eps = 0.02,         -- attempts closer than this (s) on one weapon = duplicate event
  same_frame_eps = 0.004,    -- tolerance for event-order differences inside one frame (s)
  late_grace = 0.5,          -- damage up to late_grace * window AFTER a declared miss re-classifies it
  timer_late_tol = 0.1,      -- expiry timer firing this late (s) means the client stalled

  -- adaptive confirmation window (seconds)
  window_min = 0.20,
  window_max = 1.5,
  window_default = 0.5,      -- used until ping samples exist
  window_rtt_mult = 1.5,     -- window = mult * RTT + jitter_mult * jitter + floor
  window_jitter_mult = 2.0,
  window_floor = 0.05,       -- server processing allowance
  -- OFF by default. The simulation (docs/SIM_RESULTS.md) showed a feedback loop: damage dealt by
  -- OTHER players gets counted as "hit latency", which lengthens the window, which admits more
  -- unrelated damage... until the window sits at window_max. Enable only if the game's damage
  -- replication is known to be slower than ping suggests.
  learn_window = false,
  window_emp_mult = 1.25,    -- (learn_window) multiplier on p95 of observed hit latency
  window_emp_min = 6,        -- (learn_window) observations needed before it is used

  -- connection diagnostics
  diag_interval = 1.0,       -- background ping sample period (s)
  diag_samples = 64,
  ewma_alpha = 0.2,
  spike_ratio = 2.5,
  spike_min_ms = 80,
  disconnect_ping_ms = 2000,
  stall_factor = 3.0,
  gap_warn = 8,              -- studs of server/client position gap worth flagging

  -- ui
  ui_refresh = 0.25,         -- minimum seconds between UI/flag refreshes
  log_size = 200,
  hud_x = 20,
  hud_y = 200,
  hud_size = 14,

  -- weapon identification (letters only, lower case; matched as substrings)
  weapon_aliases = { "doublebarrel", "dbarrel", "dbsg" },
  ammo_patterns = { "ammo", "clip", "magazine", "shell", "bullet" },   -- word start/end match
}

-- schema: { kind, min/max or enum list }
local SCHEMA = {
  enabled = { "boolean" }, hud = { "boolean" }, debug = { "boolean" },
  tab_summary = { "boolean" }, auto_mode = { "boolean" },
  follow_host_auto = { "boolean" }, host_auto_flag = { "string" },
  use_juju_signals = { "boolean" }, confirm_match = { "number", 0.05, 2 },
  confirm_horizon = { "number", 0, 5 },
  use_bullet_signal = { "boolean" }, pellet_gap = { "number", 0, 0.3 },
  scope = { "enum", { "auto", "target", "all" } },
  causal_check = { "boolean" }, causal_ratio = { "number", 0, 1 },
  burst_gap = { "number", 0, 0.1 }, dedupe_eps = { "number", 0, 0.1 },
  same_frame_eps = { "number", 0, 0.05 }, late_grace = { "number", 0, 2 },
  timer_late_tol = { "number", 0.02, 2 },
  window_min = { "number", 0.05, 5 }, window_max = { "number", 0.1, 10 },
  window_default = { "number", 0.05, 10 },
  window_rtt_mult = { "number", 0.5, 10 }, window_jitter_mult = { "number", 0, 10 },
  window_floor = { "number", 0, 1 }, learn_window = { "boolean" }, window_emp_mult = { "number", 1, 5 },
  window_emp_min = { "number", 1, 32 },
  diag_interval = { "number", 0.25, 30 }, diag_samples = { "number", 8, 512 },
  ewma_alpha = { "number", 0.01, 1 }, spike_ratio = { "number", 1.1, 20 },
  spike_min_ms = { "number", 0, 5000 }, disconnect_ping_ms = { "number", 100, 60000 },
  stall_factor = { "number", 1.5, 50 }, gap_warn = { "number", 0, 1000 },
  ui_refresh = { "number", 0.05, 5 }, log_size = { "number", 10, 2000 },
  hud_x = { "number", 0, 8000 }, hud_y = { "number", 0, 8000 }, hud_size = { "number", 8, 48 },
  weapon_aliases = { "strlist" }, ammo_patterns = { "strlist" },
}
C.schema = SCHEMA

local function copy_default(v)
  if type(v) == "table" then
    local r = {}
    for i = 1, #v do r[i] = v[i] end
    return r
  end
  return v
end

-- Returns (value, note) on success, (nil, reason) when the input is unusable.
local function coerce(spec, v)
  local kind = spec[1]
  if kind == "boolean" then
    if type(v) == "boolean" then return v end
    if v == 1 or v == "1" or v == "true" then return true end
    if v == 0 or v == "0" or v == "false" then return false end
    return nil, "expected boolean"
  elseif kind == "number" then
    if type(v) == "string" then v = tonumber(v) end
    if not U.is_finite(v) then return nil, "expected a finite number" end
    local lo, hi = spec[2], spec[3]
    if v < lo then return lo, "clamped up to " .. tostring(lo) end
    if v > hi then return hi, "clamped down to " .. tostring(hi) end
    return v
  elseif kind == "enum" then
    if type(v) == "string" then
      local s = string.lower(v)
      for i = 1, #spec[2] do
        if spec[2][i] == s then return s end
      end
    end
    return nil, "expected one of " .. table.concat(spec[2], "/")
  elseif kind == "string" then
    if type(v) == "string" then return v end
    return nil, "expected string"
  elseif kind == "strlist" then
    local items = {}
    if type(v) == "string" then
      for piece in string.gmatch(v, "[^,;]+") do items[#items + 1] = piece end
    elseif type(v) == "table" then
      for i = 1, #v do items[#items + 1] = v[i] end
    else
      return nil, "expected list of strings"
    end
    local out = {}
    for i = 1, #items do
      local n = U.normalize_name(items[i])
      if n ~= "" then out[#out + 1] = n end
    end
    if #out == 0 then return nil, "list is empty after normalisation" end
    return out
  end
  return nil, "unknown schema kind"
end

-- Cross-field rules. Mutates `values`, appends to `problems`.
local function fix_cross(values, problems)
  if values.window_min > values.window_max then
    problems[#problems + 1] = "window_min > window_max: both reset to defaults"
    values.window_min = C.defaults.window_min
    values.window_max = C.defaults.window_max
  end
  local d = U.clamp(values.window_default, values.window_min, values.window_max)
  if d ~= values.window_default then
    problems[#problems + 1] = "window_default outside [window_min, window_max]: clamped"
    values.window_default = d
  end
end

function C.sanitize(raw)
  local values, problems = {}, {}
  for k, v in pairs(C.defaults) do values[k] = copy_default(v) end
  if raw ~= nil and type(raw) ~= "table" then
    problems[#problems + 1] = "config is not a table: ignored"
    raw = nil
  end
  if raw then
    for k, v in pairs(raw) do
      local spec = SCHEMA[k]
      if not spec then
        problems[#problems + 1] = tostring(k) .. ": unknown key ignored"
      else
        local nv, note = coerce(spec, v)
        if nv == nil then
          problems[#problems + 1] = k .. ": " .. tostring(note) .. " (default kept)"
        else
          values[k] = nv
          if note then problems[#problems + 1] = k .. ": " .. note end
        end
      end
    end
  end
  fix_cross(values, problems)
  return values, problems
end

-- ---------------------------------------------------------------------------------------
-- Config object: `values` is a plain table other modules read directly.
-- ---------------------------------------------------------------------------------------
local Obj = {}
Obj.__index = Obj

function C.new(raw)
  local values, problems = C.sanitize(raw)
  return setmetatable({ values = values, problems = problems, listeners = {} }, Obj)
end

function Obj:set(key, value)
  local spec = SCHEMA[key]
  if not spec then return false, "unknown key" end
  local nv, note = coerce(spec, value)
  if nv == nil then
    self.problems[#self.problems + 1] = key .. ": " .. tostring(note)
    return false, note
  end
  if note then self.problems[#self.problems + 1] = key .. ": " .. note end
  self.values[key] = nv
  -- a user moving one window bound past the other drags the other bound along (instead of
  -- the config-file rule of resetting both to defaults)
  local v = self.values
  if key == "window_min" and v.window_min > v.window_max then
    v.window_max = U.clamp(v.window_min, 0.1, 10)
  elseif key == "window_max" and v.window_max < v.window_min then
    v.window_min = U.clamp(v.window_max, 0.05, 5)
  end
  fix_cross(self.values, self.problems)
  for i = 1, #self.listeners do
    pcall(self.listeners[i], key, self.values[key])
  end
  return true
end

function Obj:on_change(fn)
  self.listeners[#self.listeners + 1] = fn
end

-- Reads jhc_cfg_<key> flags through `get_flag(name)`; invalid entries are reported, not applied.
function Obj:load_flags(get_flag)
  local applied = 0
  for key in pairs(SCHEMA) do
    local raw = get_flag("jhc_cfg_" .. key)
    if raw ~= nil then
      if self:set(key, raw) then applied = applied + 1 end
    end
  end
  return applied
end

return C

end

__defs["host"] = function(require)
-- host.lua
-- The only module that touches Juju / Roblox globals directly. Everything else receives the
-- adapter built here, which (a) probes capabilities, (b) validates every value coming back from
-- the host, (c) guarantees the addon stays read-only towards Juju (flags: jhc_* only).

local U = require("util")

local H = {}

H.FLAG_PREFIX = "jhc_"

-- Globals the addon looks at. Built lazily so tests can pass their own environment table.
function H.default_env()
  return {
    juju = juju, game = game, task = task, Drawing = Drawing,
    Vector2 = Vector2, Color3 = Color3, Instance = Instance, print = print, warn = warn,
    getgenv = getgenv, typeof = typeof, os_clock = os and os.clock or nil,
    shared = _G,
  }
end

local JUJU_FUNCTIONS = {
  "create_tab", "create_section", "create_element", "find_element", "set_tab_text",
  "create_connection", "on_unload", "get_signal", "get_signals",
  "get_flag", "set_flag", "get_flags", "get_ragebot_target", "get_ragebot_targets",
  "get_ping", "get_server_cframe", "get_client_cframe",
}

-- Returns host, nil on success; nil, "reason" when the addon cannot run at all.
function H.detect(env)
  if type(env) ~= "table" then return nil, "no environment table" end
  local juju_t = env.juju
  if type(juju_t) ~= "table" then
    return nil, "global 'juju' not found - this addon must be executed by Juju"
  end
  if type(juju_t.on_unload) ~= "function" then
    return nil, "juju.on_unload missing - refusing to run without a cleanup hook"
  end
  if env.game == nil then return nil, "global 'game' not found" end
  local tk = env.task
  if type(tk) ~= "table" or type(tk.spawn) ~= "function" or type(tk.delay) ~= "function" then
    return nil, "task.spawn / task.delay missing"
  end
  local ok_p, players = pcall(function() return env.game:GetService("Players") end)
  if not ok_p or players == nil then return nil, "Players service unavailable" end
  local clock = env.os_clock
  if type(clock) ~= "function" then return nil, "no monotonic clock (os.clock) available" end

  local host = {
    env = env, juju = juju_t, task = tk, players = players, clock = clock,
    caps = {}, errors = 0, invalid_pings = 0, refused_flag_writes = 0,
  }
  for i = 1, #JUJU_FUNCTIONS do
    local n = JUJU_FUNCTIONS[i]
    host.caps[n] = type(juju_t[n]) == "function"
  end
  host.caps.drawing = type(env.Drawing) == "table" and type(env.Drawing.new) == "function"
  host.caps.task_cancel = type(tk.cancel) == "function"
  host.caps.task_wait = type(tk.wait) == "function"

  local print_fn = env.print
  host.say = function(msg)
    if type(print_fn) == "function" then pcall(print_fn, "[JHC] " .. tostring(msg)) end
  end

  function host.local_player()
    local ok, lp = pcall(function() return host.players.LocalPlayer end)
    if ok then return lp end
    return nil
  end

  -- Managed connection. juju.create_connection (documented: auto-disconnects on unload) is tried
  -- first. LIVE FINDING: called from a script that is not loaded as a Juju addon it returned nil
  -- and connected NOTHING. So a result that is not a real connection object is treated as "did not
  -- connect" and the signal is connected directly; this addon's own unload hook disconnects it.
  host.connect_fallbacks = 0
  function host.connect(signal, fn)
    if type(signal) == "table" and signal.__direct then return signal:Connect(fn) end   -- Juju custom signal
    if host.caps.create_connection then
      local ok, conn = pcall(juju_t.create_connection, signal, fn)
      if ok and conn ~= nil then
        local okd, d = pcall(function() return conn.Disconnect end)
        if okd and d ~= nil then return conn end
      end
      host.connect_fallbacks = host.connect_fallbacks + 1
    end
    return signal:Connect(fn)
  end

  -- One-time, asynchronous check of what juju.create_connection really does here, using a
  -- throwaway BindableEvent. Result in host.connect_behaviour:
  --   returns_connection   documented behaviour
  --   noop_returns_nil     does nothing (seen when not loaded as a Juju addon): fallback is correct
  --   connects_returns_nil connects but hands back nothing: the fallback may double-connect (warned)
  --   errors               raised an error
  function host.probe_connect(on_done)
    local I = env.Instance
    if not (host.caps.create_connection and type(I) == "table" and type(I.new) == "function"
            and host.caps.task_wait) then
      return
    end
    pcall(host.task.spawn, function()
      local okb, be = pcall(I.new, "BindableEvent")
      if not okb or be == nil then return end
      local fired = 0
      local ok, conn = pcall(juju_t.create_connection, be.Event, function() fired = fired + 1 end)
      pcall(function() be:Fire() end)
      host.task.wait(0.1)
      local mode
      if not ok then
        mode = "errors"
      elseif conn ~= nil and fired > 0 then
        mode = "returns_connection"
      elseif conn ~= nil then
        mode = "returns_connection_but_silent"
      elseif fired > 0 then
        mode = "connects_returns_nil"
        host.dup_risk = true
      else
        mode = "noop_returns_nil"
      end
      if conn ~= nil then pcall(function() conn:Disconnect() end) end
      pcall(function() be:Destroy() end)
      host.connect_behaviour = mode
      if on_done then pcall(on_done, mode) end
    end)
  end

  function host.ping()
    if not host.caps.get_ping then return nil end
    local ok, v = pcall(juju_t.get_ping)
    if not ok then host.errors = host.errors + 1; return nil end
    if not U.is_finite(v) or v <= 0 or v > 1e6 then
      host.invalid_pings = host.invalid_pings + 1
      return nil
    end
    return v
  end

  -- |server - client| position of the local HumanoidRootPart (documented get_*_cframe pair).
  function host.gap()
    if not (host.caps.get_server_cframe and host.caps.get_client_cframe) then return nil end
    local ok, d = pcall(function()
      local s = juju_t.get_server_cframe()
      local c = juju_t.get_client_cframe()
      return (s.Position - c.Position).Magnitude
    end)
    if ok and U.is_finite(d) then return d end
    return nil
  end

  -- Wrap an already-obtained Juju custom signal so host.connect attaches to it directly
  -- (create_connection is documented for RBXScriptSignals).
  function host.wrap_signal(sig)
    if sig == nil then return nil end
    local okc, c = pcall(function() return sig.Connect end)
    if not okc or c == nil then return nil end
    return { __direct = true, Connect = function(_, fn) return sig:Connect(fn) end }
  end

  -- Juju custom signal by name (documented get_signal), or nil. Wrapped so host.connect connects it
  -- directly (create_connection is documented for RBXScriptSignals).
  function host.juju_signal(name)
    if not host.caps.get_signal then return nil end
    local ok, sig = pcall(juju_t.get_signal, name)
    if not ok or sig == nil then return nil end
    return host.wrap_signal(sig)
  end

  function host.get_flag(name)
    if not host.caps.get_flag then return nil end
    local ok, v = pcall(juju_t.get_flag, name)
    if ok then return v end
    host.errors = host.errors + 1
    return nil
  end

  -- Hard read-only guard: only jhc_* flags can ever be written.
  function host.set_flag(name, value)
    if not host.caps.set_flag then return false, "set_flag unavailable" end
    if type(name) ~= "string" or string.sub(name, 1, #H.FLAG_PREFIX) ~= H.FLAG_PREFIX then
      host.refused_flag_writes = host.refused_flag_writes + 1
      return false, "refused: flag outside jhc_ namespace"
    end
    local ok = pcall(juju_t.set_flag, name, value)
    if not ok then host.errors = host.errors + 1; return false, "set_flag failed" end
    return true
  end

  function host.flag_names()
    if not host.caps.get_flags then return {} end
    local ok, v = pcall(juju_t.get_flags)
    if ok and type(v) == "table" then return v end
    return {}
  end

  function host.ragebot_target()
    if not host.caps.get_ragebot_target then return nil end
    local ok, p = pcall(juju_t.get_ragebot_target)
    if ok and p ~= nil then return p end
    return nil
  end

  function host.ragebot_on()
    local v = host.get_flag("ragebot")
    if v == nil then return nil end
    return v and true or false
  end

  -- Shared table for the duplicate-load guard (executor getgenv() when present, else _G).
  function host.registry()
    local ok, g = pcall(function()
      if type(env.getgenv) == "function" then return env.getgenv() end
      return nil
    end)
    if ok and type(g) == "table" then return g end
    if type(env.shared) == "table" then return env.shared end
    H._fallback_registry = H._fallback_registry or {}
    return H._fallback_registry
  end

  -- Human readable capability matrix for the report.
  function host.caps_lines()
    local lines = {}
    local names = {}
    for k in pairs(host.caps) do names[#names + 1] = k end
    table.sort(names)
    for i = 1, #names do
      lines[#lines + 1] = string.format("  %-22s %s", names[i], host.caps[names[i]] and "yes" or "NO")
    end
    return lines
  end

  return host, nil
end

return H

end

__defs["diag"] = function(require)
-- diag.lua
-- Connection diagnostics built ONLY from what the documented API exposes:
--   juju.get_ping() (ms), and the server/client CFrame position gap.
-- Derived values (jitter, spikes, stalls, adaptive window) are computed here; nothing else
-- about the network (packet loss, server tick, ...) is observable and none is claimed.

local U = require("util")

local D = {}
D.__index = D

function D.new(deps)
  local cfg = deps.cfg
  local self = setmetatable({}, D)
  self.cfg = cfg
  self.now = deps.now
  self.get_ping = deps.get_ping or function() return nil end
  self.get_gap = deps.get_gap or function() return nil end
  self.log = deps.log or function() end
  self.samples = U.Ring.new(cfg.diag_samples)
  self.spikes = U.Ring.new(32)      -- timestamps of spike samples
  self.stalls = U.Ring.new(16)      -- {t0, t1} client stalls seen by the background sampler
  self.lat = U.Ring.new(32)         -- observed shot->damage latencies (s), source unknown
  self.tlat = U.Ring.new(32)        -- TRUSTED latencies: hits Juju itself attributed to my bullet
  self.ewma = nil
  self.last_ms = nil
  self.last_bg = nil
  self.n_samples, self.n_invalid, self.n_spikes, self.n_stalls = 0, 0, 0, 0
  self.gap, self.gap_max, self.gap_warns = nil, 0, 0
  return self
end

-- Median of the most recent samples; nil until there are 5.
function D:_baseline()
  local n = self.samples:size()
  if n < 5 then return nil end
  local from = n - 15
  if from < 1 then from = 1 end
  local arr = {}
  for i = from, n do arr[#arr + 1] = self.samples:get(i).ms end
  return U.median(arr)
end

-- Take one ping sample. `background` marks the periodic sampler, which also detects client stalls
-- (a gap between two background samples much longer than the interval).
function D:sample(tag, background)
  local cfg = self.cfg
  local t = self.now()
  if background then
    if self.last_bg and (t - self.last_bg) > cfg.diag_interval * cfg.stall_factor then
      self.stalls:push({ t0 = self.last_bg, t1 = t })
      self.n_stalls = self.n_stalls + 1
      self.log("warn", string.format("client stall: %.0f ms between background samples",
        (t - self.last_bg) * 1000))
    end
    self.last_bg = t
  end
  local ms = self.get_ping()
  if ms == nil then
    self.n_invalid = self.n_invalid + 1
    return nil
  end
  local base = self:_baseline()
  local spike = ms >= cfg.disconnect_ping_ms
  if not spike and base then
    spike = ms > math.max(base * cfg.spike_ratio, base + cfg.spike_min_ms)
  end
  if spike then
    self.spikes:push(t)
    self.n_spikes = self.n_spikes + 1
    self.log("warn", string.format("ping spike %.0f ms (baseline %s) [%s]", ms,
      base and string.format("%.0f", base) or "n/a", tostring(tag)))
  end
  self.samples:push({ t = t, ms = ms, spike = spike })
  self.n_samples = self.n_samples + 1
  self.last_ms = ms
  if self.ewma == nil then
    self.ewma = ms
  else
    self.ewma = self.ewma + cfg.ewma_alpha * (ms - self.ewma)
  end
  return ms
end

function D:sample_gap()
  local g = self.get_gap()
  if g == nil then return nil end
  self.gap = g
  if g > self.gap_max then self.gap_max = g end
  if g > self.cfg.gap_warn then self.gap_warns = self.gap_warns + 1 end
  return g
end

-- Jitter (ms): MEDIAN absolute difference between consecutive recent samples. The median keeps a
-- rare spike (which is flagged separately) from inflating the confirmation window.
function D:jitter()
  local n = self.samples:size()
  if n < 2 then return 0 end
  local from = n - 15
  if from < 1 then from = 1 end
  local diffs = {}
  local prev = self.samples:get(from).ms
  for i = from + 1, n do
    local cur = self.samples:get(i).ms
    diffs[#diffs + 1] = math.abs(cur - prev)
    prev = cur
  end
  return U.median(diffs) or 0
end

function D:p95()
  local n = self.samples:size()
  if n == 0 then return nil end
  local arr = {}
  for i = 1, n do arr[i] = self.samples:get(i).ms end
  return U.percentile(arr, 95)
end

-- Record the delay between a shot and the damage it produced.
-- `trusted` means Juju itself attributed the hit to the local player's bullet
-- (on_local_bullet_confirmed). Only those feed the window, because they cannot be another player's
-- damage, so the feedback loop that disables `learn_window` by default cannot occur.
function D:note_latency(sec, trusted)
  if not (U.is_finite(sec) and sec > 0) then return end
  if trusted then self.tlat:push(sec) end
  self.lat:push(sec)
end

-- p95 of trusted latencies once there are enough of them.
function D:trusted_latency()
  if self.tlat:size() < self.cfg.window_emp_min then return nil end
  return U.percentile(self.tlat:to_array(), 95)
end

-- Confirmation window in seconds, derived from measured ping and jitter:
--   window = rtt_mult * RTT_ref + jitter_mult * jitter + floor      (clamped to [min, max])
-- RTT_ref = max(median of recent samples, latest sample): robust against a single spike, yet a
-- rising ping widens the window immediately through the latest sample. The optional learn_window
-- term (default OFF) lifts it to emp_mult * p95(observed hit latency).
function D:window()
  local cfg = self.cfg
  local model = 0
  if self.samples:size() > 0 then
    local ref = math.max(self:_baseline() or self.ewma or 0, self.last_ms or 0)
    model = cfg.window_rtt_mult * ref / 1000 + cfg.window_jitter_mult * self:jitter() / 1000
      + cfg.window_floor
  end
  local emp = 0
  -- LIVE FINDING: in the observed Hood Customs session the confirmation arrived ~2.9 x ping after
  -- the shot, well beyond mult * RTT. Trusted (Juju-attributed) latencies therefore always widen
  -- the window; untrusted ones only when the user opts in with learn_window.
  local trusted = self:trusted_latency()
  if trusted then
    emp = trusted * cfg.window_emp_mult
  elseif cfg.learn_window and self.lat:size() >= cfg.window_emp_min then
    emp = (U.percentile(self.lat:to_array(), 95) or 0) * cfg.window_emp_mult
  end
  local w = math.max(model, emp)
  if w <= 0 then w = cfg.window_default end
  return U.clamp(w, cfg.window_min, cfg.window_max)
end

-- true + reason if a spike or client stall overlaps [t0, t1] (a spike seen just before t0 counts:
-- it describes the connection state at the moment of the shot).
function D:degraded_between(t0, t1)
  local hold = self.cfg.diag_interval
  for i = self.spikes:size(), 1, -1 do
    local ts = self.spikes:get(i)
    if ts < t0 - hold then break end
    if ts <= t1 then return true, "ping_spike" end
  end
  for i = self.stalls:size(), 1, -1 do
    local s = self.stalls:get(i)
    if s.t1 < t0 then break end
    if s.t0 <= t1 then return true, "stall" end
  end
  return false
end

-- true when a spike/stall happened within the last two sampling intervals.
function D:degraded_now()
  local t = self.now()
  local hold = self.cfg.diag_interval * 2
  local lastspike = self.spikes:last()
  if lastspike and t - lastspike <= hold then return true end
  local st = self.stalls:last()
  if st and t - st.t1 <= hold then return true end
  return false
end

function D:snapshot()
  return {
    ping = self.last_ms, avg = self.ewma, p95 = self:p95(), jitter = self:jitter(),
    samples = self.n_samples, invalid = self.n_invalid, spikes = self.n_spikes,
    stalls = self.n_stalls, gap = self.gap, gap_max = self.gap_max, gap_warns = self.gap_warns,
    window = self:window(), degraded = self:degraded_now(), lat_n = self.lat:size(),
    tlat_n = self.tlat:size(), tlat_p95 = self:trusted_latency(),
  }
end

function D:reset()
  self.samples:clear(); self.spikes:clear(); self.stalls:clear(); self.lat:clear(); self.tlat:clear()
  self.ewma, self.last_ms, self.last_bg = nil, nil, nil
  self.n_samples, self.n_invalid, self.n_spikes, self.n_stalls = 0, 0, 0, 0
  self.gap, self.gap_max, self.gap_warns = nil, 0, 0
end

return D

end

__defs["weapon"] = function(require)
-- weapon.lua
-- Weapon identification. Pure functions, no Roblox access.
--
-- The Juju docs say nothing about weapons, and the real in-game tool name of the Double Barrel
-- Shotgun is UNVERIFIED. Identification is therefore by normalised name (letters only, lower
-- case) against cfg.weapon_aliases, which the user can edit.

local U = require("util")

local W = {}

W.NONE = { key = "none", name = "none", is_dbs = false }

function W.identify(name, cfg)
  local key = U.normalize_name(name)
  if key == "" then key = "unknown" end
  local is_dbs = false
  if key ~= "unknown" then
    local aliases = cfg.weapon_aliases
    for i = 1, #aliases do
      local a = aliases[i]
      if a ~= "" and string.find(key, a, 1, true) then
        is_dbs = true
        break
      end
    end
  end
  return {
    key = key,
    name = (type(name) == "string" and name ~= "") and name or "?",
    is_dbs = is_dbs,
  }
end

-- Splits "CurrentAmmo", "ammo_count", "Max-Clip" into lower-case words.
local function words_of(name)
  if type(name) ~= "string" then return {} end
  local spaced = name:gsub("(%l)(%u)", "%1 %2"):gsub("[^%a]+", " ")
  local out = {}
  for w in string.gmatch(string.lower(spaced), "%a+") do out[#out + 1] = w end
  return out
end

-- Words that mark a CONSTANT or a stock rather than the live counter ("BulletSpeed",
-- "MagazineSize", "ShellCapacity", "ReserveAmmo", "MaxAmmo"): any word starting with one of
-- them disqualifies the name.
local NOT_LIVE = { "max", "size", "capacity", "speed", "damage", "rate", "reserve", "total", "spare",
  "stock", "limit" }

-- True when a numeric value/attribute name looks like CURRENT ammo.
-- A pattern must be the start or the end of a word ("Damage" must not match "mag").
-- Even then the source is only TRUSTED after it has been seen to decrease on a shot (world.lua).
function W.is_ammo_name(name, cfg)
  local words = words_of(name)
  if #words == 0 then return false end
  for i = 1, #words do
    for j = 1, #NOT_LIVE do
      if string.sub(words[i], 1, #NOT_LIVE[j]) == NOT_LIVE[j] then return false end
    end
  end
  local pats = cfg.ammo_patterns
  for i = 1, #words do
    local w = words[i]
    for j = 1, #pats do
      local p = pats[j]
      if string.sub(w, 1, #p) == p or (#w >= #p and string.sub(w, -#p) == p) then return true end
    end
  end
  return false
end

return W

end

__defs["engine"] = function(require)
-- engine.lua
-- Hit Checker core. Pure logic: no Roblox/Juju access. Time and timers are injected, so the
-- same code runs under a virtual clock in tests and under task.delay in the game.
--
-- Every shot attempt ends in exactly ONE outcome:
--   hit          replicated damage on an observable candidate, inside the window, not earlier
--                than the causal floor (causal_ratio * ping at shot time)
--   miss         window elapsed, nothing observed, >=1 observable candidate, healthy connection,
--                no context change, no overlap ambiguity, firing not disproved
--   unconfirmed  cannot be told (degraded connection, stall, respawn / weapon change mid-window,
--                target lost, nothing observable, ambiguous overlapping shot, late damage)
--   not_fired    a VALIDATED ammo source (one that has been seen to drop on a shot) shows no
--                decrement: cooldown / empty gun. Damage seen on such a shot is not credited to it.
-- Invariant: attempted = hit + miss + unconfirmed + not_fired + pending.
--
-- A hit is only ever produced by observed damage. Absence of damage never becomes a hit.

local U = require("util")

local E = {}
E.__index = E

local ZERO = 1e-9

local function new_bucket()
  return {
    attempted = 0, hits = 0, misses = 0, unconfirmed = 0, not_fired = 0, deduped = 0,
    fired = 0, damage = 0, lat_sum = 0, lat_n = 0, lat_min = nil, lat_max = nil,
    ratio_sum = 0, ratio_n = 0,   -- hit latency / ping at shot time (calibration aid)
    confirmed_hits = 0,           -- hits also confirmed by Juju's own on_local_bullet_confirmed
  }
end

local function is_cand(shot, uid)
  return shot.cand[uid] and not (shot.lost and shot.lost[uid])
end

-- deps: cfg (values table), now() -> seconds, timers { delay(sec, fn) -> handle, cancel(handle) },
--       diag (window / degraded_between / note_latency), log(level, msg), on_change()
function E.new(deps)
  local self = setmetatable({}, E)
  self.cfg = deps.cfg
  self.now = deps.now
  self.timers = deps.timers
  self.diag = deps.diag
  self.log = deps.log or function() end
  self.on_change = deps.on_change or function() end
  self.dead = false
  self.seq = 0
  self:_init_state()
  return self
end

function E:_init_state()
  self.pending = {}                 -- FIFO of unresolved shots
  self.by_id = {}
  self.buckets = { all = new_bucket() }
  self.counters = {
    late_damage = 0, early_damage = 0, unattributed_damage = 0, fires_matched = 0,
    fire_unmatched = 0, invalid_events = 0, clock_anomaly = 0, timer_failures = 0,
    weapon_switches = 0, shots_spanning_switch = 0,
    juju_confirms = 0, corroborated = 0, confirm_pellets = 0, confirm_unmatched = 0, promoted = 0,
  }
  self.reasons = {}                 -- unconfirmed reason -> count
  self.bursts = {}                  -- uid -> open damage burst
  self.recent_miss = U.Ring.new(16) -- recently resolved misses (for late-damage detection)
  self.recent_hit = U.Ring.new(16)  -- recently resolved hits (for Juju confirmation matching)
  self.recent_shot = U.Ring.new(16) -- every recently resolved shot (for late confirmations)
  self.cbursts = {}                 -- uid -> last Juju confirmation (pellet de-duplication)
  self.events = U.Ring.new(self.cfg.log_size)
  self.last_attempt = {}            -- weapon key -> time of last accepted attempt
  self.intervals = {}               -- weapon key -> Ring of inter-shot intervals
  self.pre_fire = {}                -- weapon key -> time of an ammo decrement seen before its shot
  self.last_shot = nil
end

function E:_bucket(name)
  local b = self.buckets[name]
  if not b then
    b = new_bucket()
    self.buckets[name] = b
  end
  return b
end

function E:_apply(shot, field, delta)
  local list = shot.b
  for i = 1, #list do
    list[i][field] = list[i][field] + delta
  end
end

function E:_event(t, kind, text)
  self.events:push({ t = t, kind = kind, text = text })
  self.log("debug", kind .. ": " .. text)
end

-- ---------------------------------------------------------------------------------------
-- Shots
-- ---------------------------------------------------------------------------------------
-- info: { t?, weapon={key,name,is_dbs}, mode="auto"|"manual", candidates={uid=true},
--         ncand?, ping_ms?, gap?, ammo_tracked? }
function E:register_shot(info)
  if self.dead then return nil, "dead" end
  local cfg = self.cfg
  local t = info.t or self.now()
  local weapon = info.weapon or { key = "unknown", name = "?", is_dbs = false }
  local mode = (info.mode == "auto") and "auto" or "manual"
  local bnames = { "all", "mode:" .. mode, "weapon:" .. weapon.key }
  local blist = {}
  for i = 1, #bnames do blist[i] = self:_bucket(bnames[i]) end

  local last = self.last_attempt[weapon.key]
  if last ~= nil and t < last then
    self.counters.clock_anomaly = self.counters.clock_anomaly + 1
    t = last
  end
  if last ~= nil and (t - last) < cfg.dedupe_eps then
    for i = 1, #blist do blist[i].deduped = blist[i].deduped + 1 end
    self:_event(t, "dedupe", weapon.key .. " duplicate attempt")
    return nil, "deduped"
  end
  if last ~= nil then
    local ring = self.intervals[weapon.key]
    if not ring then
      ring = U.Ring.new(32)
      self.intervals[weapon.key] = ring
    end
    ring:push(t - last)
  end
  self.last_attempt[weapon.key] = t

  local window = nil
  local okw, w = pcall(self.diag.window, self.diag)
  if okw and U.is_finite(w) and w > 0 then
    window = w
  else
    window = U.clamp(cfg.window_default, cfg.window_min, cfg.window_max)
  end

  local cand = {}
  local n = 0
  if type(info.candidates) == "table" then
    for uid, v in pairs(info.candidates) do
      if v then
        cand[uid] = true
        n = n + 1
      end
    end
  end

  self.seq = self.seq + 1
  local shot = {
    id = self.seq, t = t, window = window, deadline = t + window,
    weapon = weapon, mode = mode, cand = cand, ncand = n, nlive = n,
    ping = info.ping_ms, gap = info.gap, ammo_tracked = info.ammo_tracked and true or false,
    state = "pending", b = blist, overlap = false, overlap_hit = false,
    damage_total = 0, damage_events = 0, source = info.source or "activated", pellets = info.pellets or 0,
  }

  -- Ammo decrement that arrived a hair before the activation (handler order inside one frame).
  local pf = self.pre_fire[weapon.key]
  if pf ~= nil and (t - pf) >= 0 and (t - pf) <= cfg.same_frame_eps then
    shot.fire = true
    self.pre_fire[weapon.key] = nil
    self.counters.fires_matched = self.counters.fires_matched + 1
  end

  for i = 1, #blist do blist[i].attempted = blist[i].attempted + 1 end
  if shot.fire then self:_apply(shot, "fired", 1) end

  for i = 1, #self.pending do
    local o = self.pending[i]
    if o.deadline > t then
      o.overlap = true
      shot.overlap = true
    end
  end

  self.pending[#self.pending + 1] = shot
  self.by_id[shot.id] = shot
  self.last_shot = shot

  local id = shot.id
  local okt, handle = pcall(self.timers.delay, window, function() self:_on_timer(id) end)
  if okt then
    shot.timer = handle
  else
    self.counters.timer_failures = self.counters.timer_failures + 1
    self:_finish(shot, "unconfirmed", "timer_unavailable", t)
    return shot
  end

  self:_event(t, "shot", string.format("#%d %s via=%s mode=%s cand=%d window=%.0fms ping=%s",
    shot.id, weapon.key, shot.source, mode, n, window * 1000,
    shot.ping and string.format("%.0f", shot.ping) or "n/a"))
  self.on_change()
  return shot
end

function E:_on_timer(id)
  local shot = self.by_id[id]
  if not shot or self.dead then return end
  local t = self.now()
  if t < shot.deadline - 1e-6 then
    -- fired early: wait for the remainder
    local ok, handle = pcall(self.timers.delay, shot.deadline - t, function() self:_on_timer(id) end)
    if ok then
      shot.timer = handle
    else
      self.counters.timer_failures = self.counters.timer_failures + 1
      self:_finish(shot, "unconfirmed", "timer_unavailable", t)
    end
    return
  end
  shot.timer = nil
  self:_expire(shot, t)
end

function E:_expire(shot, t)
  local cfg = self.cfg
  local outcome, reason
  if shot.ncand == 0 then
    outcome, reason = "unconfirmed", "no_observable_target"
  elseif shot.nlive <= 0 then
    outcome, reason = "unconfirmed", "target_lost"
  elseif cfg.causal_check and shot.ping and shot.window <= (shot.ping / 1000) * cfg.causal_ratio then
    -- misconfigured: no damage could ever be accepted inside this window
    outcome, reason = "unconfirmed", "window_below_causal_floor"
  elseif shot.ctx then
    outcome, reason = "unconfirmed", shot.ctx
  else
    local degraded, why = false, nil
    pcall(self.diag.sample, self.diag, "expiry", false)       -- a spike that began mid-window shows up now
    local ok, d, w = pcall(self.diag.degraded_between, self.diag, shot.t, math.max(shot.deadline, t))
    if ok and d then degraded, why = true, w end
    if not degraded and (t - shot.deadline) > cfg.timer_late_tol then
      degraded, why = true, "stall"
    end
    if degraded then
      outcome, reason = "unconfirmed", "degraded:" .. tostring(why)
    elseif shot.deferred then
      outcome, reason = "not_fired", "damage_without_fire"
    elseif shot.overlap_hit then
      outcome, reason = "unconfirmed", "ambiguous_overlap"
    elseif shot.late_damage then
      outcome, reason = "unconfirmed", "late_damage"
    elseif shot.ammo_tracked and not shot.fire and not shot.weapon_switched then
      outcome, reason = "not_fired", "no_ammo_change"
    else
      outcome = "miss"
    end
  end
  self:_finish(shot, outcome, reason, t)
end

function E:_finish(shot, outcome, reason, t)
  if shot.state ~= "pending" then return end
  for i = 1, #self.pending do
    if self.pending[i] == shot then
      table.remove(self.pending, i)
      break
    end
  end
  self.by_id[shot.id] = nil
  if shot.timer ~= nil then
    pcall(self.timers.cancel, shot.timer)
    shot.timer = nil
  end
  shot.state = "resolved"
  shot.outcome = outcome
  shot.reason = reason
  shot.done_t = t
  self.recent_shot:push(shot)

  if outcome == "hit" then
    self:_apply(shot, "hits", 1)
    self:_apply(shot, "damage", shot.damage_total)
    self:_record_hit_latency(shot)
    self.recent_hit:push(shot)
    self:_event(t, "hit", string.format("#%d %s latency=%.0fms dmg=%.1f", shot.id, shot.weapon.key,
      (shot.latency or 0) * 1000, shot.damage_total))
  elseif outcome == "miss" then
    self:_apply(shot, "misses", 1)
    self.recent_miss:push(shot)
    self:_event(t, "miss", string.format("#%d %s", shot.id, shot.weapon.key))
  elseif outcome == "not_fired" then
    self:_apply(shot, "not_fired", 1)
    self:_event(t, "not_fired", string.format("#%d %s (%s)", shot.id, shot.weapon.key, tostring(reason)))
  else
    self:_apply(shot, "unconfirmed", 1)
    local key = tostring(reason)
    self.reasons[key] = (self.reasons[key] or 0) + 1
    self:_event(t, "unconfirmed", string.format("#%d %s (%s)", shot.id, shot.weapon.key, key))
  end
  self.on_change()
end

-- ---------------------------------------------------------------------------------------
-- Damage
-- ---------------------------------------------------------------------------------------
-- true if a pending shot registered after `since` could own damage on `uid` arriving at `t`
function E:_newer_shot(uid, since, t)
  for i = 1, #self.pending do
    local s = self.pending[i]
    if s.t > since and not s.burst and is_cand(s, uid) and t >= s.t and t <= s.deadline + ZERO then
      return true
    end
  end
  return false
end

-- info: { t?, uid, amount }   amount > 0 = health lost by that player (server-replicated)
function E:register_damage(info)
  if self.dead then return "dead" end
  local cfg = self.cfg
  local uid, amount = info.uid, info.amount
  if uid == nil or not U.is_finite(amount) or amount <= 0 then
    self.counters.invalid_events = self.counters.invalid_events + 1
    return "invalid"
  end
  local t = info.t or self.now()

  -- Same burst (pellets of one shot arrive together)? A burst is bounded in length and can never
  -- swallow damage that a shot registered AFTER the burst began could own.
  local b = self.bursts[uid]
  if b and t >= b.last and (t - b.last) <= cfg.burst_gap and (t - b.first) <= cfg.burst_gap * 3
     and not self:_newer_shot(uid, b.first, t) then
    b.last = t
    b.events = b.events + 1
    b.damage = b.damage + amount
    local s = b.shot
    if s then
      s.damage_total = s.damage_total + amount
      s.damage_events = s.damage_events + 1
      if s.state == "resolved" and s.outcome == "hit" then self:_apply(s, "damage", amount) end
    end
    return "burst"
  end

  -- Oldest pending shot that could have caused it.
  local chosen, early, late_pending = nil, false, nil
  for i = 1, #self.pending do
    local s = self.pending[i]
    if not s.burst and is_cand(s, uid) and t >= s.t then
      if t <= s.deadline + ZERO then
        local floor = 0
        if cfg.causal_check and s.ping then floor = (s.ping / 1000) * cfg.causal_ratio end
        if (t - s.t) < floor then
          early = true
        else
          chosen = s
        end
        break
      elseif late_pending == nil and (t - s.deadline) <= cfg.late_grace * s.window then
        late_pending = s     -- window closed but its expiry timer has not run yet
      end
    end
  end

  if chosen then
    local burst = { first = t, last = t, events = 1, damage = amount, shot = chosen }
    self.bursts[uid] = burst
    chosen.burst = burst
    chosen.victim = uid
    chosen.damage_total = amount
    chosen.damage_events = 1
    chosen.hit_t = t
    chosen.latency = t - chosen.t
    -- later overlapping shots can no longer be told apart from this damage
    for i = 1, #self.pending do
      local o = self.pending[i]
      if o ~= chosen and not o.burst and is_cand(o, uid) and t >= o.t and t <= o.deadline + ZERO then
        o.overlap_hit = true
      end
    end
    if chosen.ammo_tracked and not chosen.fire then
      -- the weapon shows no sign of having fired: wait for the ammo evidence (it can lag by up
      -- to a round trip); if none comes before the deadline the damage was someone else's
      chosen.deferred = true
      return "deferred"
    end
    self:_finish(chosen, "hit", nil, t)
    return "hit"
  end

  if early then
    self.counters.early_damage = self.counters.early_damage + 1
    self.bursts[uid] = { first = t, last = t, events = 1, damage = amount, shot = nil }
    self:_event(t, "early_damage", string.format("uid=%s %.1f dmg before causal floor: not attributed",
      tostring(uid), amount))
    return "early"
  end

  if late_pending then
    late_pending.late_damage = true
    self.counters.late_damage = self.counters.late_damage + 1
    pcall(self.diag.note_latency, self.diag, t - late_pending.t)
    self.bursts[uid] = { first = t, last = t, events = 1, damage = amount, shot = nil }
    self:_event(t, "late_damage", string.format("#%d damage after its window closed (expiry not run yet)",
      late_pending.id))
    return "late"
  end

  -- Damage shortly after a declared miss (within late_grace * window)? Then the miss was premature.
  for i = self.recent_miss:size(), 1, -1 do
    local m = self.recent_miss:get(i)
    if m.outcome == "miss" and m.cand[uid] and not (m.lost and m.lost[uid]) and t >= m.t
       and t >= m.deadline and (t - m.deadline) <= cfg.late_grace * m.window then
      self:_apply(m, "misses", -1)
      self:_apply(m, "unconfirmed", 1)
      m.outcome = "unconfirmed"
      m.reason = "late_damage"
      m.late_latency = t - m.t
      self.reasons.late_damage = (self.reasons.late_damage or 0) + 1
      self.counters.late_damage = self.counters.late_damage + 1
      pcall(self.diag.note_latency, self.diag, t - m.t)
      self.bursts[uid] = { first = t, last = t, events = 1, damage = amount, shot = nil }
      self:_event(t, "late_damage", string.format("#%d damage %.0fms after shot, %.0fms past its window: miss re-classified",
        m.id, (t - m.t) * 1000, (t - m.deadline) * 1000))
      self.on_change()
      return "late"
    end
  end

  self.counters.unattributed_damage = self.counters.unattributed_damage + 1
  self.bursts[uid] = { first = t, last = t, events = 1, damage = amount, shot = nil }
  return "unattributed"
end

function E:_record_hit_latency(shot)
  local lat = shot.latency
  if lat == nil then return end
  local list = shot.b
  for i = 1, #list do
    local b = list[i]
    b.lat_sum = b.lat_sum + lat
    b.lat_n = b.lat_n + 1
    if b.lat_min == nil or lat < b.lat_min then b.lat_min = lat end
    if b.lat_max == nil or lat > b.lat_max then b.lat_max = lat end
    if shot.ping and shot.ping > 0 then
      b.ratio_sum = b.ratio_sum + lat / (shot.ping / 1000)
      b.ratio_n = b.ratio_n + 1
    end
  end
  pcall(self.diag.note_latency, self.diag, lat, shot.juju_confirmed == true)
end

-- A Juju confirmation that arrives after its shot already expired. Juju attributes the bullet to
-- the local player, so this is positive evidence the shot hit: the earlier verdict is corrected and
-- the measured latency teaches the window (without this the window can never grow past its floor).
function E:_promote_to_hit(shot, t, uid, amount)
  local prev = shot.outcome
  if prev == "hit" then return false end
  if prev == "miss" then
    self:_apply(shot, "misses", -1)
  elseif prev == "unconfirmed" then
    self:_apply(shot, "unconfirmed", -1)
    local key = tostring(shot.reason)
    if self.reasons[key] then
      self.reasons[key] = self.reasons[key] - 1
      if self.reasons[key] <= 0 then self.reasons[key] = nil end
    end
  elseif prev == "not_fired" then
    self:_apply(shot, "not_fired", -1)
  else
    return false
  end
  shot.outcome = "hit"
  shot.reason = nil
  shot.juju_confirmed = true
  shot.promoted_from = prev
  shot.victim = uid
  shot.hit_t = t
  shot.latency = t - shot.t
  shot.damage_total = amount or shot.damage_total or 0
  self:_apply(shot, "hits", 1)
  self:_apply(shot, "confirmed_hits", 1)
  self:_apply(shot, "damage", shot.damage_total)
  self:_record_hit_latency(shot)
  self.recent_hit:push(shot)
  self.counters.promoted = self.counters.promoted + 1
  self:_event(t, "promoted", string.format("#%d %s -> hit, Juju confirmed %.0fms after the shot (%.0fms past its window)",
    shot.id, prev, shot.latency * 1000, (t - shot.deadline) * 1000))
  self.on_change()
  return true
end

-- ---------------------------------------------------------------------------------------
-- Juju's own bullet confirmation (on_local_bullet_confirmed: player hit, part, damage text)
-- ---------------------------------------------------------------------------------------
-- info: { t?, uid, amount?, part? }
-- Order seen live: the target's health drops first, the confirmation follows ~85ms later. So the
-- usual case is "corroborate a hit already inferred"; if no hit was inferred yet, the confirmation
-- itself resolves the oldest pending shot (it is attributed to a LOCAL bullet by Juju).
function E:register_confirm(info)
  if self.dead then return "dead" end
  local cfg = self.cfg
  local uid = info.uid
  if uid == nil then
    self.counters.invalid_events = self.counters.invalid_events + 1
    return "invalid"
  end
  local t = info.t or self.now()
  self.counters.juju_confirms = self.counters.juju_confirms + 1

  -- pellets of one shot are confirmed together: count the shot once
  local cb = self.cbursts[uid]
  if cb and t >= cb.last and (t - cb.last) <= cfg.burst_gap then
    cb.last = t
    self.counters.confirm_pellets = self.counters.confirm_pellets + 1
    return "burst"
  end
  self.cbursts[uid] = { last = t }

  -- 1. corroborate a hit already inferred from the target's health
  for i = self.recent_hit:size(), 1, -1 do
    local h = self.recent_hit:get(i)
    if not h.juju_confirmed and h.victim == uid and t >= h.hit_t and (t - h.hit_t) <= cfg.confirm_match then
      h.juju_confirmed = true
      self:_apply(h, "confirmed_hits", 1)
      self.counters.corroborated = self.counters.corroborated + 1
      -- now known to be a local bullet: its latency may steer the window
      if h.latency then pcall(self.diag.note_latency, self.diag, h.latency, true) end
      self:_event(t, "juju_confirmed", string.format("#%d hit confirmed by Juju %.0fms after the damage",
        h.id, (t - h.hit_t) * 1000))
      self.on_change()
      return "corroborated"
    end
  end

  -- 2a. a hit deferred for lack of fire evidence: Juju says the bullet hit, so it did fire
  for i = 1, #self.pending do
    local s = self.pending[i]
    if s.deferred and s.victim == uid then
      s.deferred = nil
      s.juju_confirmed = true
      self:_finish(s, "hit", nil, t)
      self:_apply(s, "confirmed_hits", 1)
      return "hit"
    end
  end

  -- 2b. no inferred hit yet: the confirmation resolves the oldest pending shot that preceded it
  for i = 1, #self.pending do
    local s = self.pending[i]
    if not s.burst and t >= s.t and t <= s.deadline + cfg.late_grace * s.window + ZERO then
      local burst = { first = t, last = t, events = 1, damage = info.amount or 0, shot = s }
      self.bursts[uid] = burst
      s.burst = burst
      s.victim = uid
      s.damage_total = info.amount or 0
      s.damage_events = 1
      s.hit_t = t
      s.latency = t - s.t
      s.juju_confirmed = true
      self:_finish(s, "hit", nil, t)
      self:_apply(s, "confirmed_hits", 1)
      return "hit"
    end
  end

  -- 3. the shot already expired: Juju says it hit, so correct the verdict and learn the latency
  for i = self.recent_shot:size(), 1, -1 do
    local s = self.recent_shot:get(i)
    if s.outcome ~= "hit" and (s.cand[uid] or s.ncand == 0) and t >= s.t
       and (t - s.t) <= cfg.confirm_horizon then
      if self:_promote_to_hit(s, t, uid, info.amount) then return "promoted" end
    end
  end

  self.counters.confirm_unmatched = self.counters.confirm_unmatched + 1
  return "unmatched"
end

-- ---------------------------------------------------------------------------------------
-- Fire evidence (optional ammo source)
-- ---------------------------------------------------------------------------------------
-- Another bullet of a shot already registered (shotgun pellet). Returns true if it was absorbed.
function E:add_pellet(t, weapon_key)
  local last = self.last_attempt[weapon_key]
  if last == nil or (t - last) > self.cfg.pellet_gap then return false end
  for i = #self.pending, 1, -1 do
    local s = self.pending[i]
    if s.weapon.key == weapon_key and s.t == last then
      s.pellets = s.pellets + 1
      return true
    end
  end
  -- the shot already resolved (a fast hit): still its pellet, do not open a new shot
  return true
end

-- info: { t?, weapon_key }
function E:register_fire(info)
  if self.dead then return "dead" end
  local t = info.t or self.now()
  local eps = self.cfg.same_frame_eps
  for i = 1, #self.pending do
    local s = self.pending[i]
    if not s.fire and s.weapon.key == info.weapon_key and t >= s.t - eps and t <= s.deadline + ZERO then
      s.fire = true
      self.counters.fires_matched = self.counters.fires_matched + 1
      self:_apply(s, "fired", 1)
      if s.deferred then
        s.deferred = nil
        self:_finish(s, "hit", nil, t)
      end
      return "matched"
    end
  end
  self.pre_fire[info.weapon_key] = t
  self.counters.fire_unmatched = self.counters.fire_unmatched + 1
  self:_event(t, "fire_unmatched", tostring(info.weapon_key) .. " ammo decrement without a pending attempt")
  return "unmatched"
end

-- ---------------------------------------------------------------------------------------
-- Context
-- ---------------------------------------------------------------------------------------
-- Respawn / weapon switch / weapon removal while shots are in flight. Damage that still arrives
-- is a hit as usual; silence becomes `unconfirmed(reason)` instead of `miss`.
-- A weapon change while shots are in flight.
--
-- LIVE FINDING: this used to call note_context("weapon_changed"), which made every affected shot
-- "unconfirmed". In the real game that discarded 100% of Double Barrel shots (the gun re-parents or
-- is swapped within the confirmation window) while costing only ~12% of knife shots, so the weapon
-- the user most cared about produced no usable statistics at all.
--
-- It was also wrong: once a bullet has left, the weapon you are holding no longer decides whether
-- it hit. Juju's on_local_bullet_confirmed attributes the hit to the local player's bullet, and
-- health-based attribution uses the shot's own time window and candidate set. So a switch is
-- recorded for diagnostics, and only disables the not_fired rule (the original weapon's ammo can no
-- longer be observed). Genuine context changes - respawn, death - still invalidate via note_context.
function E:note_weapon_switch()
  if self.dead then return end
  self.counters.weapon_switches = self.counters.weapon_switches + 1
  for i = 1, #self.pending do
    local s = self.pending[i]
    if not s.weapon_switched then
      s.weapon_switched = true
      self.counters.shots_spanning_switch = self.counters.shots_spanning_switch + 1
    end
  end
end

function E:note_context(reason)
  if self.dead then return end
  for i = 1, #self.pending do
    local s = self.pending[i]
    if not s.ctx then s.ctx = reason end
  end
end

function E:target_lost(uid)
  if self.dead then return end
  for i = 1, #self.pending do
    local s = self.pending[i]
    if is_cand(s, uid) then
      s.lost = s.lost or {}
      s.lost[uid] = true
      s.nlive = s.nlive - 1
    end
  end
  self.bursts[uid] = nil
  self.cbursts[uid] = nil
end

-- ---------------------------------------------------------------------------------------
-- Queries / lifecycle
-- ---------------------------------------------------------------------------------------
function E:stats(name)
  local b = self.buckets[name or "all"] or new_bucket()
  local out = U.shallow_copy(b)
  out.pending = b.attempted - b.hits - b.misses - b.unconfirmed - b.not_fired
  local resolved = b.hits + b.misses
  out.hit_pct = resolved > 0 and (b.hits / resolved * 100) or nil
  out.reg_pct = b.attempted > 0 and (b.hits / b.attempted * 100) or nil
  out.lat_avg = b.lat_n > 0 and (b.lat_sum / b.lat_n) or nil
  out.ratio_avg = b.ratio_n > 0 and (b.ratio_sum / b.ratio_n) or nil
  out.conf_pct = b.hits > 0 and (b.confirmed_hits / b.hits * 100) or nil
  return out
end

function E:bucket_names()
  local names = {}
  for k in pairs(self.buckets) do names[#names + 1] = k end
  table.sort(names)
  return names
end

function E:pending_count() return #self.pending end

-- Independent consistency check (bucket arithmetic vs the real pending list). Returns ok, message.
function E:check_invariant()
  for name, b in pairs(self.buckets) do
    local resolved = b.hits + b.misses + b.unconfirmed + b.not_fired
    if resolved > b.attempted or b.hits < 0 or b.misses < 0 or b.unconfirmed < 0 or b.not_fired < 0 then
      return false, "bucket " .. name .. " resolved more shots than were attempted"
    end
  end
  local all = self.buckets.all
  local derived = all.attempted - all.hits - all.misses - all.unconfirmed - all.not_fired
  if derived ~= #self.pending then
    return false, string.format("pending list has %d shots but counters imply %d", #self.pending, derived)
  end
  local n = 0
  for _ in pairs(self.by_id) do n = n + 1 end
  if n ~= #self.pending then
    return false, string.format("by_id has %d entries for %d pending shots", n, #self.pending)
  end
  return true, "ok"
end

function E:interval_stats(key)
  local ring = self.intervals[key]
  if not ring or ring:size() == 0 then return nil end
  local arr = ring:to_array()
  return { n = #arr, min = math.min(U.unpack(arr)), median = U.median(arr), last = arr[#arr] }
end

function E:recent_events(n)
  local out = {}
  local size = self.events:size()
  local from = size - (n or 10) + 1
  if from < 1 then from = 1 end
  for i = from, size do out[#out + 1] = self.events:get(i) end
  return out
end

function E:_cancel_all()
  for i = 1, #self.pending do
    local s = self.pending[i]
    if s.timer ~= nil then
      pcall(self.timers.cancel, s.timer)
      s.timer = nil
    end
  end
end

function E:reset()
  self:_cancel_all()
  self:_init_state()
  self.on_change()
end

function E:shutdown()
  self:_cancel_all()
  self.dead = true
  self.pending = {}
  self.by_id = {}
end

return E

end

__defs["automode"] = function(require)
-- automode.lua
-- Auto Mode state machine. Pure logic.
--
-- IMPORTANT: this does not fire weapons. The Juju docs expose no firing API, so Auto Mode here is
-- a tracking/gating mode: it knows whether the Double Barrel Shotgun is equipped and the
-- connection is healthy, and tags each shot "auto" or "manual" so the two can be compared.
--
--   OFF        mode disabled (and Juju's own auto flag not followed / not set)
--   ARMED      enabled, waiting: no character, or the equipped weapon is not the DBS
--   ACTIVE     enabled, character alive, DBS equipped, connection healthy
--   SUSPENDED  enabled, DBS equipped, but the connection is degraded (spike / stall)

local A = {}
A.__index = A

function A.new(deps)
  local self = setmetatable({}, A)
  self.cfg = deps.cfg
  self.log = deps.log or function() end
  self.on_change = deps.on_change or function() end
  self.enabled = deps.cfg.auto_mode and true or false
  self.ctx = { char_alive = false, weapon_is_dbs = false, degraded = false, host_auto = nil }
  self.state = "OFF"
  self.reason = "disabled"
  self.transitions = 0
  self:_recompute()
  return self
end

function A:effective_enabled()
  if self.enabled then return true end
  return (self.cfg.follow_host_auto and self.ctx.host_auto == true) and true or false
end

function A:_recompute()
  local state, reason
  if not self:effective_enabled() then
    state, reason = "OFF", "disabled"
  elseif not self.ctx.char_alive then
    state, reason = "ARMED", "no_character"
  elseif not self.ctx.weapon_is_dbs then
    state, reason = "ARMED", "weapon_not_dbs"
  elseif self.ctx.degraded then
    state, reason = "SUSPENDED", "connection_degraded"
  else
    state, reason = "ACTIVE", "ready"
  end
  if state ~= self.state or reason ~= self.reason then
    local old = self.state
    self.state, self.reason = state, reason
    self.transitions = self.transitions + 1
    self.log("info", string.format("auto mode %s -> %s (%s)", old, state, reason))
    self.on_change(old, state, reason)
  end
end

function A:set_enabled(on)
  self.enabled = on and true or false
  self:_recompute()
end

-- patch: any of char_alive, weapon_is_dbs, degraded, host_auto
function A:update(patch)
  for k, v in pairs(patch) do self.ctx[k] = v end
  self:_recompute()
end

-- Shots taken while Auto Mode is ACTIVE or SUSPENDED count as "auto" (SUSPENDED shots are exactly
-- the interesting unreliable ones, so they must not be hidden from the auto statistics).
function A:mode_tag()
  if self.state == "ACTIVE" or self.state == "SUSPENDED" then return "auto" end
  return "manual"
end

function A:is_active() return self.state == "ACTIVE" end

return A

end

__defs["world"] = function(require)
-- world.lua
-- Roblox glue. Translates engine-level events from standard Roblox instances/signals:
--   Tool.Activated on the equipped Tool        -> shot attempt
--   Humanoid.HealthChanged / Died (other players) -> server-replicated damage
--   numeric ammo-like child value / attribute  -> optional "weapon fired" evidence
--   Player.CharacterAdded/Removing, Character.ChildAdded/Removed -> context (respawn, equip)
-- These are standard Roblox APIs, NOT part of the Juju docs (see docs/API_REFERENCE.md section 3).
-- Every connection goes through the Bag (keyed -> no duplicates, one place to clean up).

local U = require("util")
local Weapon = require("weapon")

local W = {}
W.__index = W

local function uid_of(player)
  local ok, id = pcall(function() return player.UserId end)
  if ok and id ~= nil then return id end
  local ok2, name = pcall(function() return player.Name end)
  if ok2 then return name end
  return nil
end

-- ctx: host, cfg, engine, diag, auto, bag, log, ui_dirty()
function W.new(ctx)
  local self = setmetatable({}, W)
  self.host = ctx.host
  self.cfg = ctx.cfg
  self.engine = ctx.engine
  self.diag = ctx.diag
  self.auto = ctx.auto
  self.bag = ctx.bag
  self.log = ctx.log or function() end
  self.dirty = ctx.ui_dirty or function() end
  self.lp = nil
  self.char = nil
  self.current = nil       -- { tool, weapon, ammo_kind, ammo_last }
  self.targets = {}        -- uid -> { player, hum, last }
  self.sampler_gen = 0
  self.sampler_on = false
  self.started = false
  self.counts = { shots_seen = 0, shot_errors = 0, bullets_seen = 0 }
  return self
end

-- ---------------------------------------------------------------------------------------
-- Lifecycle
-- ---------------------------------------------------------------------------------------
function W:start()
  if self.started then return end
  self.started = true
  local host = self.host
  self.lp = host.local_player()
  local lp = self.lp
  if lp == nil then
    self.log("warn", "LocalPlayer not available: shot tracking disabled")
  else
    self.bag:set("lp:added", lp.CharacterAdded, function(c) self:_on_local_char(c) end)
    self.bag:set("lp:removing", lp.CharacterRemoving, function(c) self:_on_local_removing(c) end)
    if lp.Character then self:_on_local_char(lp.Character) end
  end
  self:_hook_juju_signals()
  local pl = host.players
  self.bag:set("pl:added", pl.PlayerAdded, function(p) self:_track_player(p) end)
  self.bag:set("pl:removing", pl.PlayerRemoving, function(p) self:_untrack_player(p) end)
  local ok, list = pcall(function() return pl:GetPlayers() end)
  if ok and type(list) == "table" then
    for i = 1, #list do self:_track_player(list[i]) end
  end
end

-- Juju's own bullet-confirmation signal, if this Juju build has it (found by name at runtime).
function W:_hook_juju_signals()
  self.juju_confirm_hooked = false
  if not self.cfg.use_juju_signals then return end
  local sig = self.host.juju_signal("on_local_bullet_confirmed")
  if sig ~= nil then
    local ok = self.bag:set("juju:confirmed", sig, function(player, part, dmg)
      self:_on_juju_confirmed(player, part, dmg)
    end)
    self.juju_confirm_hooked = ok ~= nil
  end
  self:_hook_bullet_signal()
end

-- Shot attempts for guns. Hood Customs guns do not fire Tool.Activated; this signal does, once per
-- bullet, and each client only receives its own bullets (verified with two clients).
function W:_hook_bullet_signal()
  self.bullet_hooked = false
  if not self.cfg.use_bullet_signal then return end
  local sig = self.host.juju_signal("on_player_bullet_fired")
  if sig == nil then return end
  local ok = self.bag:set("juju:fired", sig, function() self:_on_bullet_fired() end)
  self.bullet_hooked = ok ~= nil
end

function W:_on_bullet_fired()
  if not self.cfg.enabled then return end
  local cur = self.current
  if cur == nil then return end                      -- weapon unknown: do not invent a shot
  local t = self.host.clock()
  self.counts.bullets_seen = self.counts.bullets_seen + 1
  if self.engine:add_pellet(t, cur.weapon.key) then return end   -- same trigger pull
  self:_begin_shot(t, cur, "bullet")
end

function W:_on_juju_confirmed(player, part, dmg)
  if not self.cfg.enabled then return end
  local uid = (player ~= nil) and uid_of(player) or nil
  if uid == nil then
    self.engine.counters.invalid_events = self.engine.counters.invalid_events + 1
    return
  end
  local amount = tonumber(dmg)
  if amount ~= nil and U.is_finite(amount) then amount = math.abs(amount) else amount = nil end
  self.engine:register_confirm({ uid = uid, amount = amount })
  self.dirty()
end

function W:stop()
  self:stop_sampler()
  self.bag:clear()
  U.clear(self.targets)
  self.current = nil
  self.char = nil
  self.started = false
end

-- ---------------------------------------------------------------------------------------
-- Background sampler (one task, 1 wake per cfg.diag_interval, only while enabled)
-- ---------------------------------------------------------------------------------------
function W:start_sampler()
  if self.sampler_on then return end
  local host = self.host
  if not host.caps.task_wait then return end
  self.sampler_on = true
  self.sampler_gen = self.sampler_gen + 1
  local gen = self.sampler_gen
  local ok, thread = pcall(host.task.spawn, function()
    local first = true
    while self.sampler_on and gen == self.sampler_gen do
      local c0 = host.clock()
      local waited = host.task.wait(self.cfg.diag_interval)
      if first then
        first = false
        self:_check_clock(c0, waited)
      end
      if not (self.sampler_on and gen == self.sampler_gen) then break end
      local ok2, err = pcall(function() self:_sample_tick() end)
      if not ok2 then self.log("error", "sampler: " .. tostring(err)) end
    end
  end)
  if not ok then
    -- never leave the flag set when no sampler exists
    self.sampler_on = false
    self.sampler_gen = self.sampler_gen + 1
    error("sampler could not start: " .. tostring(thread), 0)
  end
  self.sampler_thread = thread
end

-- One-time sanity check of the clock the timing logic relies on: the time os.clock() advanced
-- during task.wait(n) must be about what task.wait reports. If not (e.g. a CPU-time clock), every
-- timing-based verdict is suspect and the report says so.
function W:_check_clock(c0, waited)
  local dt = self.host.clock() - c0
  if type(waited) == "number" and waited > 0 and (dt < waited * 0.5 or dt > waited * 2) then
    self.host.clock_suspect = true
    self.log("warn", string.format("clock mismatch: task.wait reported %.3fs but the clock advanced %.3fs - "
      .. "timing diagnostics are unreliable", waited, dt))
  end
end

function W:stop_sampler()
  self.sampler_on = false
  self.sampler_gen = self.sampler_gen + 1
  if self.sampler_thread ~= nil and self.host.caps.task_cancel then
    pcall(self.host.task.cancel, self.sampler_thread)
  end
  self.sampler_thread = nil
end

function W:_sample_tick()
  self.diag:sample("bg", true)
  self.diag:sample_gap()
  self:refresh_host_auto()
  self.auto:update({ degraded = self.diag:degraded_now() })
  self.dirty()
end

-- Looks for Juju's own auto flag: exact name if configured, else a name heuristic over
-- juju.get_flags() (names are NOT documented, so the result is "unknown" when nothing matches).
function W:refresh_host_auto()
  local host, cfg = self.host, self.cfg
  local name = cfg.host_auto_flag
  if name == nil or name == "" then
    if self.host_flag_name == nil then
      -- rescan at most every 30 ticks: get_flags() is a host call and the flag may appear later
      self.scan_wait = (self.scan_wait or 0) - 1
      if self.scan_wait <= 0 then
        self.scan_wait = 30
        local flags = host.flag_names()
        for i = 1, #flags do
          local n = U.normalize_name(tostring(flags[i]))
          if string.find(n, "automode", 1, true) or n == "auto" then
            self.host_flag_name = flags[i]
            break
          end
        end
      end
    end
    name = self.host_flag_name
  end
  if name == nil or name == "" then
    self.auto:update({ host_auto = nil })
    return
  end
  local v = host.get_flag(name)
  if v == nil then
    self.auto:update({ host_auto = nil })
  else
    self.auto:update({ host_auto = (v and v ~= 0) and true or false })
  end
end

-- ---------------------------------------------------------------------------------------
-- Local player: character, tool
-- ---------------------------------------------------------------------------------------
function W:_on_local_char(char)
  self.bag:drop_prefix("char:")
  self.bag:drop_prefix("tool:")
  self.current = nil
  self.char = char
  self.auto:update({ char_alive = true, weapon_is_dbs = false })
  local bag = self.bag
  bag:set("char:added", char.ChildAdded, function(c)
    self:_maybe_equip(c)
    self:_maybe_local_humanoid(c)
  end)
  bag:set("char:removed", char.ChildRemoved, function(c) self:_maybe_unequip(c) end)
  local ok, hum = pcall(function() return char:FindFirstChildOfClass("Humanoid") end)
  if ok and hum then
    bag:set("char:died", hum.Died, function() self:_on_local_died() end)
  end
  local ok2, kids = pcall(function() return char:GetChildren() end)
  if ok2 and type(kids) == "table" then
    for i = 1, #kids do self:_maybe_equip(kids[i]) end
  end
  self.dirty()
end

-- The local Humanoid can replicate after the Character model: hook Died when it shows up.
function W:_maybe_local_humanoid(inst)
  local ok, isHum = pcall(function() return inst:IsA("Humanoid") end)
  if ok and isHum then
    self.bag:set("char:died", inst.Died, function() self:_on_local_died() end)
  end
end

function W:_on_local_died()
  self.engine:note_context("died")
  self.auto:update({ char_alive = false })
  self.dirty()
end

function W:_on_local_removing()
  self.engine:note_context("respawn")
  self.bag:drop_prefix("char:")
  self.bag:drop_prefix("tool:")
  self.current = nil
  self.char = nil
  self.auto:update({ char_alive = false, weapon_is_dbs = false })
  self.dirty()
end

local function is_tool(inst)
  local ok, r = pcall(function() return inst:IsA("Tool") end)
  return ok and r == true
end

function W:_maybe_equip(inst)
  if not is_tool(inst) then return end
  if self.current and self.current.tool == inst then return end   -- duplicate ChildAdded
  if self.current then
    self.engine:note_weapon_switch()
    self.bag:drop_prefix("tool:")
    self.current = nil
  end
  self:_set_weapon(inst)
end

function W:_maybe_unequip(inst)
  if not (self.current and self.current.tool == inst) then return end
  self.engine:note_weapon_switch()
  self.bag:drop_prefix("tool:")
  self.current = nil
  self.auto:update({ weapon_is_dbs = false })
  self.dirty()
end

function W:_set_weapon(tool)
  local nameok, name = pcall(function() return tool.Name end)
  local weapon = Weapon.identify(nameok and name or nil, self.cfg)
  local cur = { tool = tool, weapon = weapon }
  self.current = cur
  self.bag:set("tool:activated", tool.Activated, function() self:_on_activated(tool) end)
  self:_find_ammo(cur)
  self.auto:update({ weapon_is_dbs = weapon.is_dbs })
  self.log("info", string.format("equipped %s (key=%s dbs=%s ammo=%s)", weapon.name, weapon.key,
    tostring(weapon.is_dbs), cur.ammo_kind or "none"))
  self.dirty()
end

-- Optional "weapon fired" evidence: first numeric ammo-like value child or attribute.
function W:_find_ammo(cur)
  local tool, cfg = cur.tool, self.cfg
  local ok, kids = pcall(function() return tool:GetChildren() end)
  if ok and type(kids) == "table" then
    for i = 1, #kids do
      local k = kids[i]
      local isnum = false
      pcall(function() isnum = k:IsA("IntValue") or k:IsA("NumberValue") end)
      if isnum and Weapon.is_ammo_name(k.Name, cfg) then
        cur.ammo_kind = "value:" .. tostring(k.Name)
        cur.ammo_validated = false
        cur.ammo_last = k.Value
        self.bag:set("tool:ammo", k.Changed, function(v) self:_on_ammo(tool, v) end)
        return
      end
    end
  end
  local ok2, attrs = pcall(function() return tool:GetAttributes() end)
  if ok2 and type(attrs) == "table" then
    for name, val in pairs(attrs) do
      if type(val) == "number" and Weapon.is_ammo_name(name, cfg) then
        cur.ammo_kind = "attr:" .. tostring(name)
        cur.ammo_validated = false
        cur.ammo_last = val
        self.bag:set("tool:ammo", tool:GetAttributeChangedSignal(name), function()
          self:_on_ammo(tool, tool:GetAttribute(name))
        end)
        return
      end
    end
  end
end

function W:_on_ammo(tool, v)
  local cur = self.current
  if not cur or cur.tool ~= tool or not self.cfg.enabled then return end
  if not U.is_finite(v) then return end
  local last = cur.ammo_last
  cur.ammo_last = v
  if last ~= nil and v < last then
    cur.ammo_validated = true      -- it really drops: from now on its silence means "did not fire"
    self.engine:register_fire({ t = self.host.clock(), weapon_key = cur.weapon.key })
  elseif last ~= nil and v > last then
    self.log("debug", "reload detected (" .. tostring(cur.ammo_kind) .. ")")
  end
end

function W:_on_activated(tool)
  local cur = self.current
  if not cur or cur.tool ~= tool or not self.cfg.enabled then return end
  self.counts.shots_seen = self.counts.shots_seen + 1
  local host = self.host
  local t = host.clock()
  -- the name may carry changing text (ammo counters): identify again, key ignores digits
  local ok, nm = pcall(function() return tool.Name end)
  if ok then
    local w = Weapon.identify(nm, self.cfg)
    if w.key ~= cur.weapon.key or w.is_dbs ~= cur.weapon.is_dbs then
      cur.weapon = w
      self.auto:update({ weapon_is_dbs = w.is_dbs })
    end
  end
  self:_begin_shot(t, cur, "activated")
end

function W:_begin_shot(t, cur, source)
  local ping = self.diag:sample("shot", false)
  local gap = self.diag:sample_gap()
  local cand, n = self:_candidates()
  self.engine:register_shot({
    t = t, weapon = cur.weapon, mode = self.auto:mode_tag(), candidates = cand, ncand = n,
    ping_ms = ping, gap = gap, ammo_tracked = (cur.ammo_kind ~= nil and cur.ammo_validated == true),
    source = source, pellets = (source == "bullet") and 1 or 0,
  })
  self.dirty()
end

-- Snapshot of players whose damage could confirm this shot (only players we actually observe).
function W:_candidates()
  local scope = self.cfg.scope
  local set, n = {}, 0
  local rt = nil
  if scope ~= "all" then rt = self.host.ragebot_target() end
  if scope == "target" or (scope == "auto" and rt ~= nil) then
    if rt ~= nil then
      local uid = uid_of(rt)
      local tg = uid ~= nil and self.targets[uid] or nil
      if tg and tg.hum then
        set[uid] = true
        n = 1
      end
    end
    return set, n
  end
  for uid, tg in pairs(self.targets) do
    if tg.hum then
      set[uid] = true
      n = n + 1
    end
  end
  return set, n
end

-- ---------------------------------------------------------------------------------------
-- Other players: Humanoid health
-- ---------------------------------------------------------------------------------------
function W:_track_player(p)
  if p == self.lp then return end
  local uid = uid_of(p)
  if uid == nil or self.targets[uid] then return end
  self.targets[uid] = { player = p, hum = nil, last = nil }
  local bag = self.bag
  local key = "t:" .. tostring(uid) .. ":"
  bag:set(key .. "added", p.CharacterAdded, function(c) self:_hook_target(uid, c) end)
  bag:set(key .. "removing", p.CharacterRemoving, function() self:_unhook_target(uid) end)
  local ok, c = pcall(function() return p.Character end)
  if ok and c then self:_hook_target(uid, c) end
end

function W:_hook_target(uid, char)
  local tg = self.targets[uid]
  if not tg then return end
  local key = "t:" .. tostring(uid) .. ":"
  self.bag:drop_prefix(key .. "h")
  tg.hum, tg.last = nil, nil
  local ok, hum = pcall(function() return char:FindFirstChildOfClass("Humanoid") end)
  if ok and hum then
    self:_bind_humanoid(uid, hum)
  else
    -- Humanoid may arrive after the character model
    self.bag:set(key .. "hwait", char.ChildAdded, function(c)
      local isHum = false
      pcall(function() isHum = c:IsA("Humanoid") end)
      if isHum then
        self.bag:drop(key .. "hwait")
        self:_bind_humanoid(uid, c)
      end
    end)
  end
end

function W:_bind_humanoid(uid, hum)
  local tg = self.targets[uid]
  if not tg then return end
  local key = "t:" .. tostring(uid) .. ":"
  tg.hum = hum
  local okh, h = pcall(function() return hum.Health end)
  tg.last = okh and h or nil
  self.bag:set(key .. "hp", hum.HealthChanged, function(health) self:_on_health(uid, health) end)
  -- every Humanoid-scoped key starts with "h" so drop_prefix(key .. "h") releases them all
  self.bag:set(key .. "hdied", hum.Died, function() self:_on_target_died(uid) end)
end

function W:_on_health(uid, health)
  local tg = self.targets[uid]
  if not tg or type(health) ~= "number" or health ~= health then return end
  local last = tg.last
  tg.last = health
  if last ~= nil and health < last and self.cfg.enabled then
    self.engine:register_damage({ uid = uid, amount = last - health })
  end
end

function W:_on_target_died(uid)
  local tg = self.targets[uid]
  if not tg then return end
  local last = tg.last
  if last ~= nil and last > 0 and self.cfg.enabled then
    tg.last = 0
    self.engine:register_damage({ uid = uid, amount = last })
  end
end

function W:_unhook_target(uid)
  local tg = self.targets[uid]
  if not tg then return end
  self.bag:drop_prefix("t:" .. tostring(uid) .. ":h")
  tg.hum, tg.last = nil, nil
  self.engine:target_lost(uid)
end

function W:_untrack_player(p)
  local uid = uid_of(p)
  if uid == nil or not self.targets[uid] then return end
  self.bag:drop_prefix("t:" .. tostring(uid) .. ":")
  self.targets[uid] = nil
  self.engine:target_lost(uid)
end

function W:target_count()
  return U.count(self.targets)
end

return W

end

__defs["ui"] = function(require)
-- ui.lua
-- Presentation: Juju menu (documented create_tab / create_section / create_element, element
-- types toggle + slider ONLY), optional Drawing HUD, tab-text summary, jhc_* flag export,
-- and the text report.
--
-- Refreshing is event-driven and throttled: mark_dirty() schedules ONE flush at most every
-- cfg.ui_refresh seconds; a flush re-renders only lines whose text changed. No polling loop.

local U = require("util")
local Config = require("config")

local UI = {}
UI.__index = UI

local SCOPE_BY_NUM = { "auto", "target", "all" }
local NUM_BY_SCOPE = { auto = 1, target = 2, all = 3 }

-- ctx: host, cfgobj, engine, diag, auto, world, actions{reset,dump,apply_enabled}, log
function UI.new(ctx)
  local self = setmetatable({}, UI)
  self.host = ctx.host
  self.cfgobj = ctx.cfgobj
  self.cfg = ctx.cfgobj.values
  self.engine = ctx.engine
  self.diag = ctx.diag
  self.auto = ctx.auto
  self.world = ctx.world
  self.actions = ctx.actions
  self.log = ctx.log or function() end
  self.elements = {}
  self.bound = {}
  self.bag_set = ctx.bag_set      -- keyed connect, so menu signals are released on unload
  self.menu_ok = false
  self.menu_style = "none"
  self.hud = nil
  self.hud_failed = false
  self.dirty = false
  self.scheduled = false
  self.dead = false
  self.last_render = -1e9
  self.flag_cache = {}
  self.tab_text_cache = nil
  self.renders = 0
  self.flag_writes = 0
  return self
end

-- ---------------------------------------------------------------------------------------
-- Text
-- ---------------------------------------------------------------------------------------
local function pct(v)
  if v == nil then return "n/a" end
  return string.format("%.1f%%", v)
end

local function ms(v)
  if v == nil then return "n/a" end
  return string.format("%.0fms", v)
end

function UI:weapon_label()
  local cur = self.world and self.world.current
  if not cur then return "none" end
  return cur.weapon.name .. (cur.weapon.is_dbs and " [DBS]" or "")
end

-- Pure: builds the HUD lines from current state.
function UI:lines()
  local cfg = self.cfg
  local s = self.engine:stats("all")
  local d = self.diag:snapshot()
  local a = self.engine:stats("mode:auto")
  local m = self.engine:stats("mode:manual")
  local c = self.engine.counters
  local L = {}
  L[#L + 1] = string.format("JHC %s  %s", Config.VERSION, cfg.enabled and "[ON]" or "[OFF]")
  L[#L + 1] = string.format("Weapon: %s", self:weapon_label())
  L[#L + 1] = string.format("Auto Mode: %s (%s)", self.auto.state, self.auto.reason)
  L[#L + 1] = string.format("Shots %d  Hit %d  Miss %d  Unconf %d  NoFire %d  Pend %d",
    s.attempted, s.hits, s.misses, s.unconfirmed, s.not_fired, s.pending)
  L[#L + 1] = string.format("Hit%% %s (%d/%d)  Reg%% %s  Juju-conf %d/%d", pct(s.hit_pct), s.hits,
    s.hits + s.misses, pct(s.reg_pct), s.confirmed_hits, s.hits)
  L[#L + 1] = string.format("Auto %d/%d hit  Manual %d/%d hit", a.hits, a.attempted, m.hits, m.attempted)
  L[#L + 1] = string.format("Ping %s avg %s p95 %s jit %s  gap %s", ms(d.ping), ms(d.avg), ms(d.p95),
    ms(d.jitter), d.gap and string.format("%.1f", d.gap) or "n/a")
  L[#L + 1] = string.format("Window %s  spikes %d  stalls %d  late %d  early %d", ms(d.window * 1000),
    d.spikes, d.stalls, c.late_damage, c.early_damage)
  local last = self.engine.last_shot
  if last then
    local what = last.outcome or "pending"
    if last.outcome == "hit" then
      what = string.format("HIT %s", ms(last.latency * 1000))
    elseif last.outcome then
      what = string.upper(last.outcome) .. (last.reason and (" (" .. last.reason .. ")") or "")
    end
    L[#L + 1] = string.format("Last #%d: %s", last.id, what)
  else
    L[#L + 1] = "Last: -"
  end
  return L
end

function UI:tab_text()
  local s = self.engine:stats("all")
  local text = string.format("H%d M%d %s", s.hits, s.misses, s.hit_pct and string.format("%d%%",
    math.floor(s.hit_pct + 0.5)) or "-")
  return string.sub(text, 1, 12)
end

-- Multi-line report for the console (debug/test info).
function UI:report()
  local cfg = self.cfg
  local R = {}
  local function add(fmt, ...) R[#R + 1] = string.format(fmt, ...) end
  add("==== JHC report v%s ====", Config.VERSION)
  add("enabled=%s scope=%s auto_mode=%s state=%s(%s) weapon=%s", tostring(cfg.enabled), cfg.scope,
    tostring(self.auto.enabled), self.auto.state, self.auto.reason, self:weapon_label())
  local names = self.engine:bucket_names()
  for i = 1, #names do
    local s = self.engine:stats(names[i])
    add("[%s] att=%d hit=%d miss=%d unconf=%d nofire=%d pend=%d dedupe=%d hit%%=%s reg%%=%s lat(avg/min/max)=%s/%s/%s dmg=%.1f",
      names[i], s.attempted, s.hits, s.misses, s.unconfirmed, s.not_fired, s.pending, s.deduped,
      pct(s.hit_pct), pct(s.reg_pct), ms(s.lat_avg and s.lat_avg * 1000),
      ms(s.lat_min and s.lat_min * 1000), ms(s.lat_max and s.lat_max * 1000), s.damage)
    if s.hits > 0 then add("      hits also confirmed by Juju's own bullet signal: %d of %d", s.confirmed_hits, s.hits) end
    if s.ratio_avg then add("      hit latency / ping at shot = %.2f (1.0 = exactly one round trip)", s.ratio_avg) end
  end
  local inv_ok, inv_msg = self.engine:check_invariant()
  if not inv_ok then add("!! INTERNAL INVARIANT BROKEN: %s (please report this)", inv_msg) end
  if self.host.clock_suspect then
    add("!! CLOCK WARNING: os.clock disagreed with task.wait; all timing-based verdicts are unreliable")
  end
  local reasons = {}
  for k, v in pairs(self.engine.reasons) do reasons[#reasons + 1] = k .. "=" .. v end
  table.sort(reasons)
  add("unconfirmed reasons: %s", #reasons > 0 and table.concat(reasons, ", ") or "none")
  local c = self.engine.counters
  add("counters: late=%d early=%d unattributed_dmg=%d fires_matched=%d fire_unmatched=%d invalid=%d clock_anomaly=%d timer_fail=%d",
    c.late_damage, c.early_damage, c.unattributed_damage, c.fires_matched, c.fire_unmatched,
    c.invalid_events, c.clock_anomaly, c.timer_failures)
  add("weapon switches=%d, shots still in flight across one=%d (recorded, no longer discarded)",
    c.weapon_switches, c.shots_spanning_switch)
  local d = self.diag:snapshot()
  add("ping=%s avg=%s p95=%s jitter=%s samples=%d invalid=%d spikes=%d stalls=%d gap=%s gap_max=%.1f gap_warns=%d window=%s obs=%d trusted=%d%s",
    ms(d.ping), ms(d.avg), ms(d.p95), ms(d.jitter), d.samples, d.invalid, d.spikes, d.stalls,
    d.gap and string.format("%.1f", d.gap) or "n/a", d.gap_max, d.gap_warns, ms(d.window * 1000),
    d.lat_n, d.tlat_n, d.tlat_p95 and (" p95=" .. ms(d.tlat_p95 * 1000) .. " (window follows this)") or "")
  local cur = self.world and self.world.current
  if cur then
    local iv = self.engine:interval_stats(cur.weapon.key)
    add("weapon key=%s dbs=%s ammo_source=%s%s interval(min/med)=%s", cur.weapon.key, tostring(cur.weapon.is_dbs),
      cur.ammo_kind or "none", cur.ammo_kind and (cur.ammo_validated and " (validated)" or " (unvalidated: not used until it drops on a shot)") or "",
      iv and (ms(iv.min * 1000) .. "/" .. ms(iv.median * 1000)) or "n/a")
  end
  add("targets observed=%d  host_auto=%s  host_flag=%s", self.world and self.world:target_count() or 0,
    tostring(self.auto.ctx.host_auto), tostring(self.world and self.world.host_flag_name or "none"))
  add("menu: %s (%d controls)", self.menu_style, (function()
    local n = 0
    for _ in pairs(self.elements) do n = n + 1 end
    return n
  end)())
  add("juju bullet signal (on_player_bullet_fired, shot source for guns): %s  bullets=%d",
    (self.world and self.world.bullet_hooked) and "hooked" or "not available/disabled",
    self.world and self.world.counts.bullets_seen or 0)
  add("  of which promoted after their window closed: %d (each one also teaches the window)", c.promoted)
  add("juju native hit signal (on_local_bullet_confirmed): %s  confirms=%d corroborated=%d pellets=%d unmatched=%d",
    (self.world and self.world.juju_confirm_hooked) and "hooked" or "not available/disabled", c.juju_confirms,
    c.corroborated, c.confirm_pellets, c.confirm_unmatched)
  add("connections: create_connection behaviour=%s direct-connect fallbacks=%d%s",
    tostring(self.host.connect_behaviour or "not probed yet"), self.host.connect_fallbacks or 0,
    self.host.dup_risk and "  !! duplicate-listener risk" or "")
  add("-- capabilities --")
  for _, line in ipairs(self.host.caps_lines()) do R[#R + 1] = line end
  if #self.cfgobj.problems > 0 then
    add("-- config problems --")
    for i = 1, #self.cfgobj.problems do R[#R + 1] = "  " .. self.cfgobj.problems[i] end
  end
  add("-- last events --")
  local ev = self.engine:recent_events(12)
  for i = 1, #ev do add("  %.3f %-14s %s", ev[i].t, ev[i].kind, ev[i].text) end
  add("limits: hits = replicated damage on another player after a shot; attribution is probabilistic;")
  add("        misses = no damage in window on a healthy connection; the connection exploit itself is not observable.")
  return table.concat(R, "\n")
end

-- ---------------------------------------------------------------------------------------
-- Juju menu
-- ---------------------------------------------------------------------------------------
function UI:_add(section, info, handler)
  local function cb(val)
    -- self.syncing: we are pushing the current config into the controls; the config already
    -- holds these values, so the handlers must not act (the world is not even started yet)
    if self.dead or self.syncing then return end
    local ok, err = pcall(handler, val)
    if not ok then self.log("error", "ui '" .. info.name .. "': " .. tostring(err)) end
  end
  local ok, el = pcall(function() return section:create_element(info, { callback = cb }) end)
  if not ok then
    self.log("error", "create_element '" .. info.name .. "' failed: " .. tostring(el))
    return nil
  end
  return el
end

local function set_value(el, v)
  if el == nil then return end
  pcall(function() el:set_value(v) end)   -- documented on find_element results only: best effort
end

function UI:_release(el)
  local prev = self.syncing
  self.syncing = true
  set_value(el, false)
  self.syncing = prev
end

-- ---------------------------------------------------------------------------------------
-- Menu
--
-- LIVE FINDING: this Juju build has TWO different element APIs.
--   * addon style (what real addons use):
--         juju.create_element({ name = .., section = .. }, { toggle = { default = .., flag = .. } })
--     The element TYPE is the key of the second table, there is no create_tab/create_section, and
--     the state lives in the bound flag. Elements expose on_toggle_change / set_toggle.
--   * documented style (juju-docs): create_tab -> create_section -> section:create_element(info,
--     { callback = .. }). Called from outside an addon context those return nil and build nothing.
-- The addon style is tried first, the documented one is the fallback, so the menu appears whichever
-- API the host actually provides.
-- ---------------------------------------------------------------------------------------

function UI:_apply(key, v)
  local cfgobj, cfg = self.cfgobj, self.cfg
  if key == "enabled" then
    cfgobj:set("enabled", v)
    if self.actions.apply_enabled then self.actions.apply_enabled() end
    self:mark_dirty()
  elseif key == "hud" then
    cfgobj:set("hud", v); self:apply_hud(); self:mark_dirty()
  elseif key == "debug" then
    cfgobj:set("debug", v)
  elseif key == "tab_summary" then
    cfgobj:set("tab_summary", v); self.tab_text_cache = nil; self:mark_dirty()
  elseif key == "auto_mode" then
    cfgobj:set("auto_mode", v); self.auto:set_enabled(cfg.auto_mode); self:mark_dirty()
  elseif key == "follow_host_auto" then
    cfgobj:set("follow_host_auto", v); self.auto:update({}); self:mark_dirty()
  elseif key == "window_max" then
    if type(v) == "number" then cfgobj:set("window_max", v / 1000) end
  elseif key == "window_min" then
    if type(v) == "number" then cfgobj:set("window_min", v / 1000) end
  elseif key == "scope" then
    if type(v) == "number" then
      local i = math.floor(v + 0.5)
      if i < 1 then i = 1 elseif i > 3 then i = 3 end
      cfgobj:set("scope", SCOPE_BY_NUM[i])
    end
  elseif key == "reset" then
    self.actions.reset()
  elseif key == "report" then
    self.actions.dump()
  end
end

function UI:_specs()
  local cfg = self.cfg
  return {
    { key = "enabled", name = "Enabled", sec = "Hit Checker", kind = "toggle", default = cfg.enabled },
    { key = "hud", name = "Show HUD", sec = "Hit Checker", kind = "toggle", default = cfg.hud },
    { key = "debug", name = "Debug log", sec = "Hit Checker", kind = "toggle", default = cfg.debug },
    { key = "tab_summary", name = "Live tab summary", sec = "Hit Checker", kind = "toggle", default = cfg.tab_summary },
    { key = "reset", name = "Reset stats", sec = "Hit Checker", kind = "button" },
    { key = "report", name = "Print report", sec = "Hit Checker", kind = "button" },
    { key = "window_max", name = "Max window ms", sec = "Hit Checker", kind = "slider",
      min = 250, max = 3000, default = math.floor(cfg.window_max * 1000 + 0.5), suffix = "ms" },
    { key = "window_min", name = "Min window ms", sec = "Hit Checker", kind = "slider",
      min = 100, max = 1000, default = math.floor(cfg.window_min * 1000 + 0.5), suffix = "ms" },
    { key = "auto_mode", name = "Auto Mode DBS", sec = "Auto Mode", kind = "toggle", default = cfg.auto_mode },
    { key = "follow_host_auto", name = "Follow Juju auto", sec = "Auto Mode", kind = "toggle", default = cfg.follow_host_auto },
    { key = "scope", name = "Scope 1auto 2tgt 3all", sec = "Auto Mode", kind = "slider",
      min = 1, max = 3, default = NUM_BY_SCOPE[cfg.scope] or 1 },
  }
end

local function flag_for(spec)
  if spec.kind == "toggle" then return "jhc_cfg_" .. spec.key end   -- shares the config namespace
  return "jhc_ui_" .. spec.key
end

-- Addon style. Returns created_count, failure_reason_if_zero.
function UI:_build_addon_menu()
  local juju = self.host.juju
  local created = 0
  self.bound = {}
  local specs = self:_specs()
  for i = 1, #specs do
    local spec = specs[i]
    local info = { name = spec.name, section = spec.sec }
    local body
    if spec.kind == "slider" then
      body = { slider = { flag = flag_for(spec), min = spec.min, max = spec.max,
                          default = spec.default, suffix = spec.suffix } }
    else
      local def = false
      if spec.kind == "toggle" then def = spec.default and true or false end
      body = { toggle = { flag = flag_for(spec), default = def } }
    end
    local ok, el = pcall(juju.create_element, info, body)
    if not ok then
      if created == 0 then return 0, tostring(el) end   -- wrong API for this host: fall back
      self.log("error", "create_element '" .. spec.name .. "': " .. tostring(el))
    elseif el ~= nil then
      created = created + 1
      self.elements[spec.key] = el
      local rec = { flag = flag_for(spec), spec = spec, last = nil }
      self.bound[#self.bound + 1] = rec
      local sig = nil
      pcall(function() sig = el.on_toggle_change or el.on_slider_change end)
      if sig ~= nil and self.bag_set then
        local wrapped = self.host.wrap_signal(sig)
        if wrapped then
          self.bag_set("ui:" .. spec.key, wrapped, function(v) self:_on_control(rec, v) end)
        end
      end
    end
  end
  return created
end

function UI:_on_control(rec, v)
  if self.dead or self.syncing then return end
  local spec = rec.spec
  rec.last = v
  if spec.kind == "button" then
    if v == true or v == 1 then
      self:_apply(spec.key, true)
      self:_clear_button(rec)
    end
    return
  end
  self:_apply(spec.key, v)
end

function UI:_clear_button(rec)
  local prev = self.syncing
  self.syncing = true
  rec.last = false
  local el = self.elements[rec.spec.key]
  if el ~= nil then
    pcall(function() el:set_toggle(false) end)
    pcall(function() el:set_value(false) end)
  end
  self.host.set_flag(rec.flag, false)
  self.syncing = prev
end

-- Backup for hosts without change signals, and for sliders: read the bound flags.
function UI:_poll_flags()
  if self.dead or not self.bound then return end
  for i = 1, #self.bound do
    local rec = self.bound[i]
    local v = self.host.get_flag(rec.flag)
    if v ~= nil and v ~= rec.last then self:_on_control(rec, v) end
  end
end

-- Documented style.
function UI:_build_doc_menu()
  local host, juju = self.host, self.host.juju
  local caps = host.caps
  if not (caps.create_tab and caps.create_section) then return 0 end
  local created = 0
  local ok, err = pcall(function()
    juju.create_tab()
    if caps.set_tab_text then juju.set_tab_text("HitCheck") end
    local secs = {
      ["Hit Checker"] = juju.create_section("Hit Checker", 1, 1, 0),
      ["Auto Mode"] = juju.create_section("Auto Mode", 2, 1, 0),
    }
    if secs["Hit Checker"] == nil or secs["Auto Mode"] == nil then
      error("juju.create_section returned nil", 0)
    end
    local specs = self:_specs()
    for i = 1, #specs do
      local spec = specs[i]
      local info
      if spec.kind == "slider" then
        info = { name = spec.name, type = "slider", min = spec.min, max = spec.max }
      else
        info = { name = spec.name, type = "toggle" }
      end
      local el = self:_add(secs[spec.sec], info, function(v)
        if spec.kind == "button" then
          self:_apply(spec.key, true)
          self:_release(self.elements[spec.key])
        else
          self:_apply(spec.key, v)
        end
      end)
      if el ~= nil then
        created = created + 1
        self.elements[spec.key] = el
      end
    end
    self.syncing = true
    for i = 1, #specs do
      local spec = specs[i]
      if spec.kind ~= "button" then set_value(self.elements[spec.key], spec.default) end
    end
    self.syncing = false
  end)
  self.syncing = false
  if not ok then
    self.log("error", "building menu failed: " .. tostring(err))
  end
  return created
end

-- Flag-bound menus need a heartbeat of their own: the throttled refresh stops while tracking is
-- disabled, and without it a host that offers no change signals could never re-enable the addon.
function UI:start_menu_poll()
  if self.menu_style ~= "addon" or self.poll_on or self.dead then return end
  self.poll_on = true
  local period = self.cfg.ui_refresh * 4
  if period < 1 then period = 1 end
  local function tick()
    if self.dead or not self.poll_on then return end
    local ok, err = pcall(function() self:_poll_flags() end)
    if not ok then self.log("error", "menu poll: " .. tostring(err)) end
    local ok2, h = pcall(self.host.task.delay, period, tick)
    if ok2 then self.poll_handle = h else self.poll_on = false end
  end
  local ok, h = pcall(self.host.task.delay, period, tick)
  if ok then self.poll_handle = h else self.poll_on = false end
end

function UI:build_menu()
  self.syncing = true      -- ignore callbacks the host may fire while elements are created
  local created, why = self:_build_addon_menu()
  if created > 0 then
    self.menu_style = "addon"
  else
    if why then
      self.log("info", "addon-style create_element not accepted (" .. string.sub(tostring(why), 1, 80)
        .. "); trying the documented tab/section API")
    end
    self.elements = {}
    self.bound = {}
    created = self:_build_doc_menu()
    self.menu_style = (created > 0) and "documented" or "none"
  end
  self.syncing = false
  self.menu_ok = created > 0
  if not self.menu_ok then
    self.log("warn", "no menu controls could be created (is this loaded as a Juju addon? "
      .. "tracking, HUD and the console report still work)")
  else
    self.log("info", string.format("menu built: %d controls via the %s API", created, self.menu_style))
    self:start_menu_poll()
  end
  return self.menu_ok
end

-- ---------------------------------------------------------------------------------------
-- HUD (Drawing: executor standard, referenced by the on_unload doc example)
-- ---------------------------------------------------------------------------------------
function UI:_ensure_hud(n)
  if self.hud_failed or not self.host.caps.drawing then return false end
  self.hud = self.hud or {}
  local env = self.host.env
  local cfg = self.cfg
  while #self.hud < n do
    local i = #self.hud + 1
    local ok, obj = pcall(env.Drawing.new, "Text")
    if ok and obj ~= nil then
      local ok2, err2 = pcall(function()
        obj.Size = cfg.hud_size
        obj.Outline = true
        obj.Visible = false
        obj.Text = ""
        if env.Color3 and env.Color3.new then obj.Color = env.Color3.new(1, 1, 1) end
        if env.Vector2 and env.Vector2.new then
          obj.Position = env.Vector2.new(cfg.hud_x, cfg.hud_y + (i - 1) * (cfg.hud_size + 3))
        end
      end)
      if not ok2 then
        pcall(function() obj:Remove() end)        -- never leave a half-configured object on screen
        ok, obj = false, err2
      end
    end
    if not ok or obj == nil then
      self.hud_failed = true
      self.log("warn", "Drawing HUD unavailable: " .. tostring(obj))
      return false
    end
    self.hud[i] = { obj = obj, text = "" }
  end
  return true
end

function UI:apply_hud()
  if self.hud then
    for i = 1, #self.hud do
      pcall(function() self.hud[i].obj.Visible = self.cfg.hud end)
    end
  end
end

function UI:render_hud()
  if not self.cfg.hud then return end
  local lines = self:lines()
  if not self:_ensure_hud(#lines) then return end
  for i = 1, #lines do
    local h = self.hud[i]
    if h.text ~= lines[i] then
      h.text = lines[i]
      pcall(function() h.obj.Text = lines[i] end)
    end
    pcall(function() h.obj.Visible = true end)
  end
end

-- ---------------------------------------------------------------------------------------
-- Flags / tab text / flush
-- ---------------------------------------------------------------------------------------
function UI:export_flags()
  local s = self.engine:stats("all")
  local vals = {
    jhc_version = Config.VERSION, jhc_shots = s.attempted, jhc_hits = s.hits, jhc_misses = s.misses,
    jhc_unconfirmed = s.unconfirmed, jhc_not_fired = s.not_fired,
    jhc_hit_pct = s.hit_pct and math.floor(s.hit_pct * 10 + 0.5) / 10 or -1,
    jhc_auto_state = self.auto.state, jhc_weapon = self:weapon_label(),
  }
  for name, v in pairs(vals) do
    if self.flag_cache[name] ~= v then
      self.flag_cache[name] = v
      if self.host.set_flag(name, v) then self.flag_writes = self.flag_writes + 1 end
    end
  end
end

function UI:update_tab_text()
  if not self.host.caps.set_tab_text or not self.menu_ok then return end
  local want
  if self.cfg.tab_summary or self.hud_failed or not self.host.caps.drawing or not self.cfg.hud then
    want = self:tab_text()
  else
    want = "HitCheck"
  end
  if want ~= self.tab_text_cache then
    self.tab_text_cache = want
    pcall(self.host.juju.set_tab_text, want)
  end
end

function UI:flush()
  if self.dead or not self.dirty then return end
  self.dirty = false
  self.last_render = self.host.clock()
  self.renders = self.renders + 1
  local ok, err = pcall(function()
    self:_poll_flags()        -- menu controls bound to flags (addon-style hosts)
    self:render_hud()
    self:export_flags()
    self:update_tab_text()
  end)
  if not ok then self.log("error", "ui flush: " .. tostring(err)) end
end

function UI:mark_dirty()
  if self.dead then return end
  self.dirty = true
  if self.scheduled then return end
  self.scheduled = true
  local wait = self.cfg.ui_refresh - (self.host.clock() - self.last_render)
  if wait < 0 then wait = 0 end
  local ok, handle = pcall(self.host.task.delay, wait, function()
    self.scheduled = false
    self.flush_handle = nil
    self:flush()
  end)
  if ok then
    self.flush_handle = handle
  else
    self.scheduled = false
    self.log("error", "ui: could not schedule refresh")
  end
end

function UI:destroy()
  self.dead = true
  self.poll_on = false
  if self.poll_handle ~= nil and self.host.caps.task_cancel then
    pcall(self.host.task.cancel, self.poll_handle)
  end
  self.poll_handle = nil
  if self.flush_handle ~= nil and self.host.caps.task_cancel then
    pcall(self.host.task.cancel, self.flush_handle)
  end
  self.flush_handle = nil
  if self.hud then
    for i = 1, #self.hud do
      pcall(function() self.hud[i].obj:Remove() end)
    end
    self.hud = nil
  end
end

return UI

end

__defs["main"] = function(require)
-- main.lua
-- Composition root: builds the modules, wires them together, registers the unload hook FIRST
-- (so a failure half-way through init is still cleaned up), guards against double loading.

local U = require("util")
local Config = require("config")
local Host = require("host")
local Diag = require("diag")
local Engine = require("engine")
local Auto = require("automode")
local World = require("world")
local UI = require("ui")

local M = {}

-- user_cfg: optional table (see config.lua); env: optional environment table (tests)
-- Returns inst on success, or nil, "reason".
function M.start(user_cfg, env)
  env = env or Host.default_env()
  local host, herr = Host.detect(env)
  if not host then
    local p = type(env) == "table" and env.print or print
    if type(p) == "function" then pcall(p, "[JHC] init failed: " .. tostring(herr)) end
    return nil, herr
  end

  -- duplicate-load guard: shut an older instance down before replacing it
  local reg = host.registry()
  local prev = reg.__JHC_INSTANCE
  if type(prev) == "table" and type(prev.shutdown) == "function" then
    host.say("previous instance found - shutting it down before reload")
    pcall(prev.shutdown, "reload")
  end

  local cfgobj = Config.new(user_cfg)
  local cfg = cfgobj.values
  local logger = U.make_logger(cfg, host.say, cfg.log_size)
  local log = logger.log
  local inst = { version = Config.VERSION, host = host, cfgobj = cfgobj, cfg = cfg, dead = false,
                 errors = 0, logger = logger }
  local engine, diag, auto, bag, world, ui

  function inst.shutdown(reason)
    if inst.dead then return end
    inst.dead = true
    if world then pcall(world.stop, world) end
    if bag then pcall(bag.clear, bag) end
    if engine then pcall(engine.shutdown, engine) end
    if ui then pcall(ui.destroy, ui) end
    if reg.__JHC_INSTANCE == inst then reg.__JHC_INSTANCE = nil end
    pcall(host.set_flag, "jhc_loaded", false)       -- other addons must not see a stale "loaded"
    host.say("unloaded (" .. tostring(reason or "unload") .. ")")
  end

  local ok, err = pcall(function()
    -- 1. cleanup hook before anything that can leak
    host.juju.on_unload(function() inst.shutdown("unload") end)

    -- 2. configuration (defaults < USER_CONFIG < jhc_cfg_* flags)
    local applied = cfgobj:load_flags(host.get_flag)
    if applied > 0 then log("info", applied .. " setting(s) loaded from jhc_cfg_* flags") end
    for i = 1, #cfgobj.problems do log("warn", "config: " .. cfgobj.problems[i]) end

    -- 3. modules
    local function ui_dirty() if ui then ui:mark_dirty() end end
    local timers = {
      delay = function(sec, fn) return host.task.delay(sec, fn) end,
      cancel = function(h) if h ~= nil and host.caps.task_cancel then host.task.cancel(h) end end,
    }
    diag = Diag.new({ cfg = cfg, now = host.clock, get_ping = host.ping, get_gap = host.gap, log = log })
    auto = Auto.new({ cfg = cfg, log = log, on_change = ui_dirty })
    engine = Engine.new({ cfg = cfg, now = host.clock, timers = timers, diag = diag, log = log,
                          on_change = ui_dirty })
    local err_counts = {}
    bag = U.Bag.new(host.connect, function(key, e)
      inst.errors = inst.errors + 1
      -- a handler failing on every event must not flood the console: first 3, then every 100th
      local n = (err_counts[key] or 0) + 1
      err_counts[key] = n
      if n <= 3 or n % 100 == 0 then
        log("error", string.format("handler '%s' (failure #%d): %s", tostring(key), n, tostring(e)))
      end
    end)
    world = World.new({ host = host, cfg = cfg, engine = engine, diag = diag, auto = auto, bag = bag,
                        log = log, ui_dirty = ui_dirty })

    local actions = {}
    function actions.reset()
      engine:reset()
      diag:reset()
      diag:sample("reset")
      log("info", "statistics reset")
      ui_dirty()
    end
    function actions.dump()
      local report = ui:report()
      for line in string.gmatch(report, "[^\n]+") do host.say(line) end
    end
    function actions.apply_enabled()
      if cfg.enabled then world:start_sampler() else world:stop_sampler() end
    end

    ui = UI.new({ host = host, cfgobj = cfgobj, engine = engine, diag = diag, auto = auto, world = world,
                  actions = actions, log = log,
                  bag_set = function(key, sig, fn) return bag:set(key, sig, fn) end })

    -- 4. menu (non-fatal), world, sampler
    ui:build_menu()
    world:start()
    host.probe_connect(function(mode)
      if mode == "noop_returns_nil" then
        log("warn", "juju.create_connection did nothing here (not loaded as a Juju addon?): using direct "
          .. "connections; they are released by this addon's own unload hook")
      elseif mode == "connects_returns_nil" then
        log("warn", "juju.create_connection connects but returns no connection object: listeners may be "
          .. "registered twice (host.dup_risk)")
      elseif mode ~= "returns_connection" then
        log("warn", "juju.create_connection behaves unexpectedly: " .. tostring(mode))
      end
    end)
    if cfg.enabled then
      diag:sample("init")
      world:start_sampler()
    end
    auto:set_enabled(cfg.auto_mode)
    host.set_flag("jhc_loaded", true)
    ui:mark_dirty()
  end)

  if not ok then
    log("error", "init failed: " .. tostring(err))
    inst.shutdown("init_failed")
    return nil, tostring(err)
  end

  inst.engine, inst.diag, inst.auto, inst.world, inst.ui, inst.bag = engine, diag, auto, world, ui, bag
  function inst.stats(name) return engine:stats(name) end
  function inst.report() return ui:report() end
  function inst.reset() engine:reset(); diag:reset() end

  reg.__JHC_INSTANCE = inst
  host.say(string.format("v%s loaded (menu=%s hud=%s weapons: aliases=%s)", Config.VERSION,
    tostring(ui.menu_ok), tostring(host.caps.drawing), table.concat(cfg.weapon_aliases, "/")))
  return inst
end

return M

end


return __require("main").start(USER_CONFIG)
